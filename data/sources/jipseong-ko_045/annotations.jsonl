{"chunkId": "chunk_jipseong-ko_045_ko_045_0040_0010", "id": null, "offset": 19, "parentSeq": null, "seq": 1, "text": "碣石山, 在東北海中.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0040_0010", "id": null, "offset": 24, "parentSeq": null, "seq": 2, "text": "朝鮮, 東夷.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0040_0010", "id": null, "offset": 31, "parentSeq": null, "seq": 3, "text": "東方有大人之國也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0040_0010", "id": null, "offset": 53, "parentSeq": null, "seq": 4, "text": "皆日所出之地.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0110_0010", "id": null, "offset": 37, "parentSeq": null, "seq": 1, "text": "諸馮·負夏·鳴條, 皆地名也. 負夏在海東方夷之地, 故曰東夷之人也.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0240_0010", "id": null, "offset": 42, "parentSeq": null, "seq": 1, "text": "上音藏, 下音哥.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0290_0010", "id": null, "offset": 21, "parentSeq": null, "seq": 1, "text": "經無幽州, 而周官有焉. 蓋冀之別也. 居燕國, 今廣陽是.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0380_0010", "id": null, "offset": 35, "parentSeq": null, "seq": 1, "text": "鮮卑名也", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0380_0020", "id": null, "offset": 61, "parentSeq": null, "seq": 1, "text": "迊軍隨流水.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0410_0010", "id": null, "offset": 25, "parentSeq": null, "seq": 1, "text": "廆胡罪切.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0410_0010", "id": null, "offset": 51, "parentSeq": null, "seq": 2, "text": "毖音柲.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0410_0010", "id": null, "offset": 337, "parentSeq": null, "seq": 3, "text": "皝音晃.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0500_0010", "id": null, "offset": 8, "parentSeq": null, "seq": 1, "text": "高麗之役", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0510_0010", "id": null, "offset": 198, "parentSeq": null, "seq": 1, "text": "文德之戰之北遷, 延令敵飢疲, 亦同持久之義.」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0560_0010", "id": null, "offset": 33, "parentSeq": null, "seq": 1, "text": "音兎", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0930_0010", "id": null, "offset": 124, "parentSeq": null, "seq": 1, "text": "詢形體么麽, 故高祖有是言耳.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0940_0010", "id": null, "offset": 31, "parentSeq": null, "seq": 1, "text": "音鴨, 亦音腸.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0940_0010", "id": null, "offset": 49, "parentSeq": null, "seq": 2, "text": "所謂家無儋石之儲者也. 音擔, 或作甔.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0960_0010", "id": null, "offset": 20, "parentSeq": null, "seq": 1, "text": "祿父, 紂之子也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0960_0010", "id": null, "offset": 42, "parentSeq": null, "seq": 2, "text": "朝鮮, 今樂浪郡.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0960_0030", "id": null, "offset": 169, "parentSeq": null, "seq": 1, "text": "王險, 地名.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0960_0030", "id": null, "offset": 334, "parentSeq": null, "seq": 2, "text": "師古曰:『責讓也. 音才笑切.』", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0960_0030", "id": null, "offset": 359, "parentSeq": null, "seq": 3, "text": "長, 裨王名也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0960_0030", "id": null, "offset": 826, "parentSeq": null, "seq": 4, "text": "師古曰:『相路一人也, 韓陶二人也, 尼谿相參三也, 將軍王唊四也. 唊音頰.』", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0960_0040", "id": null, "offset": 78, "parentSeq": null, "seq": 1, "text": "如淳曰:『有其四, 其四不見.』", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0980_0010", "id": null, "offset": 348, "parentSeq": null, "seq": 1, "text": "魁頭, 猶科頭也, 謂以髮縈繞成科結也. 紒音計.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0980_0010", "id": null, "offset": 496, "parentSeq": null, "seq": 2, "text": "蘇塗者, 似浮塗.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0990_0010", "id": null, "offset": 138, "parentSeq": null, "seq": 1, "text": "皆其官名.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_0990_0010", "id": null, "offset": 232, "parentSeq": null, "seq": 2, "text": "扁音補典切.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1000_0010", "id": null, "offset": 155, "parentSeq": null, "seq": 1, "text": "廉斯, 邑名. 諟音是.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1010_0030", "id": null, "offset": 30, "parentSeq": null, "seq": 1, "text": "音悏", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1010_0040", "id": null, "offset": 112, "parentSeq": null, "seq": 1, "text": "年, 昌", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1010_0050", "id": null, "offset": 253, "parentSeq": null, "seq": 1, "text": "也. 其", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1010_0050", "id": null, "offset": 337, "parentSeq": null, "seq": 2, "text": "亦秦", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1010_0050", "id": null, "offset": 405, "parentSeq": null, "seq": 3, "text": "至見", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1020_0010", "id": null, "offset": 213, "parentSeq": null, "seq": 1, "text": "音斯", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1030_0040", "id": null, "offset": 41, "parentSeq": null, "seq": 1, "text": "先本辰韓種也, 辰韓始一也. 或稱魏", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1040_0030", "id": null, "offset": 211, "parentSeq": null, "seq": 1, "text": "冠軍", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1040_0030", "id": null, "offset": 440, "parentSeq": null, "seq": 2, "text": "任那·加羅·秦韓六國", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1050_0020", "id": null, "offset": 30, "parentSeq": null, "seq": 1, "text": "地方", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1050_0020", "id": null, "offset": 179, "parentSeq": null, "seq": 2, "text": "又以十月", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1050_0020", "id": null, "offset": 291, "parentSeq": null, "seq": 3, "text": "之後", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1050_0030", "id": null, "offset": 243, "parentSeq": null, "seq": 1, "text": "養令", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1050_0110", "id": null, "offset": 414, "parentSeq": null, "seq": 1, "text": "篳篥", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1050_0170", "id": null, "offset": 172, "parentSeq": null, "seq": 1, "text": "恒令", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1080_0010", "id": null, "offset": 149, "parentSeq": null, "seq": 1, "text": "魏志所載同.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1100_0010", "id": null, "offset": 51, "parentSeq": null, "seq": 1, "text": "伯雅, 高昌國王名也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1240_0010", "id": null, "offset": 22, "parentSeq": null, "seq": 1, "text": "馬高三尺, 乘於菓樹下, 行.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1320_0010", "id": null, "offset": 64, "parentSeq": null, "seq": 1, "text": "海上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1350_0010", "id": null, "offset": 93, "parentSeq": null, "seq": 1, "text": "鳥鳥郭璞, 或或注, 爾雅曰尸鳩布毂非戴勝也, 爾雅紡在戴絍下然曰案爾, 王鳥名爾方言依此, 義又失之, 廣雅同也.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1370_0020", "id": null, "offset": 16, "parentSeq": null, "seq": 1, "text": "出東夷濊, 獻其皮.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1380_0010", "id": null, "offset": 14, "parentSeq": null, "seq": 1, "text": "郭璞曰:『知蛛兩音.』", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_045_ko_045_1380_0010", "id": null, "offset": 39, "parentSeq": null, "seq": 2, "text": "齊人又呼爲杜公, 亦言罔工, 音毒.", "type": "원주"}
