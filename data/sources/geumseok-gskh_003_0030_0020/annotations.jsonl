{"chunkId": "chunk_geumseok-gskh_003_0030_0020_gskh_003_0030_0020_0020", "id": "gskh_003_0030_0020_0020_0011", "offset": 127, "parentSeq": null, "seq": 11, "text": "大舍〓(秦弘燮, 92쪽; 李蘭暎, 52쪽: 中吉功, 425쪽; 최병식, 414쪽), ▼{火+舍}(文明大, 270쪽), 小舍(김주영, 68쪽)", "type": "각주"}
{"chunkId": "chunk_geumseok-gskh_003_0030_0020_gskh_003_0030_0020_0020", "id": "gskh_003_0030_0020_0020_0012", "offset": 137, "parentSeq": null, "seq": 12, "text": "大舍〓(秦弘燮, 92쪽; 李蘭暎, 52쪽: 中吉功, 425쪽; 최병식, 414쪽)", "type": "각주"}
{"chunkId": "chunk_geumseok-gskh_003_0030_0020_gskh_003_0030_0020_0020", "id": "gskh_003_0030_0020_0020_0013", "offset": 141, "parentSeq": null, "seq": 13, "text": "小舍〓(秦弘燮, 92쪽; 李蘭暎, 52쪽: 中吉功, 425쪽; 최병식, 414쪽), ▼{火+舍}(文明大, 270쪽)", "type": "각주"}
{"chunkId": "chunk_geumseok-gskh_003_0030_0020_gskh_003_0030_0020_0020", "id": "gskh_003_0030_0020_0020_0014", "offset": 142, "parentSeq": null, "seq": 14, "text": "▨ 弐(黃壽永, 80쪽), 式(李蘭暎, 52쪽; 中吉功, 425쪽), 大(『불비상 염원을 새기다』, 27쪽), 貳(김주성, 69쪽), ▨(郭東錫, 205쪽), 夫(강진원, 295쪽)", "type": "각주"}
{"chunkId": "chunk_geumseok-gskh_003_0030_0020_gskh_003_0030_0020_0020", "id": "gskh_003_0030_0020_0020_0015", "offset": 145, "parentSeq": null, "seq": 15, "text": "小舍 ▼{▨+舍}(『불비상 염원을 새기다』, 27쪽), ▼{火+舍}(文明大, 270쪽)", "type": "각주"}
