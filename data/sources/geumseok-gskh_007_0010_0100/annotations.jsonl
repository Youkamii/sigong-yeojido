{"chunkId": "chunk_geumseok-gskh_007_0010_0100_gskh_007_0010_0100_0020", "id": null, "offset": 2448, "parentSeq": null, "seq": 57, "text": "其二.", "type": "소자쌍행"}
{"chunkId": "chunk_geumseok-gskh_007_0010_0100_gskh_007_0010_0100_0020", "id": null, "offset": 2496, "parentSeq": null, "seq": 58, "text": "其三.", "type": "소자쌍행"}
{"chunkId": "chunk_geumseok-gskh_007_0010_0100_gskh_007_0010_0100_0020", "id": null, "offset": 2544, "parentSeq": null, "seq": 59, "text": "其四.", "type": "소자쌍행"}
