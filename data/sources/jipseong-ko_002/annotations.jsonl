{"chunkId": "chunk_jipseong-ko_002_ko_002_0010_0010", "id": null, "offset": 9, "parentSeq": null, "seq": 1, "text": "合關東, 從通之於秦, 故曰連橫者也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0010_0010", "id": null, "offset": 35, "parentSeq": null, "seq": 2, "text": "利, 饒也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0010_0010", "id": null, "offset": 46, "parentSeq": null, "seq": 3, "text": "用, 用武也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0010_0010", "id": null, "offset": 57, "parentSeq": null, "seq": 4, "text": "皆有塞險要也, 故曰之限也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0010_0010", "id": null, "offset": 66, "parentSeq": null, "seq": 5, "text": "肴, 在澠池西. 函關, 舊在弘農城北門外, 今在新安東. 固, 牢堅, 難攻易守也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0010_0010", "id": null, "offset": 104, "parentSeq": null, "seq": 6, "text": "沃野千里, 故田美民富.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0010_0010", "id": null, "offset": 110, "parentSeq": null, "seq": 7, "text": "攻之不可得, 守之不可壞, 故曰形便也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0010_0010", "id": null, "offset": 117, "parentSeq": null, "seq": 8, "text": "府, 聚也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0010_0010", "id": null, "offset": 150, "parentSeq": null, "seq": 9, "text": "敎, 習也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0010_0010", "id": null, "offset": 162, "parentSeq": null, "seq": 10, "text": "呑, 滅也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0010_0010", "id": null, "offset": 183, "parentSeq": null, "seq": 11, "text": "奏, 事. 效, 驗也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0020_0010", "id": null, "offset": 80, "parentSeq": null, "seq": 1, "text": "一本無漆身字.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0030_0010", "id": null, "offset": 5, "parentSeq": null, "seq": 1, "text": "一本無上二字,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0040_0010", "id": null, "offset": 163, "parentSeq": null, "seq": 1, "text": "『續』云, 史備燕·三胡·秦·韓之邊.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0040_0010", "id": null, "offset": 201, "parentSeq": null, "seq": 2, "text": "集, 劉錢作簡主實晉陽, 而襄主兼戎取代.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0040_0010", "id": null, "offset": 376, "parentSeq": null, "seq": 3, "text": "一作聞.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0070_0010", "id": null, "offset": 119, "parentSeq": null, "seq": 1, "text": "一作批, 曾錢作棑.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_002_ko_002_0070_0010", "id": null, "offset": 443, "parentSeq": null, "seq": 2, "text": "曾錢作秦王懸金.", "type": "원주"}
