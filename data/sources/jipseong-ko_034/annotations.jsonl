{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0010", "id": null, "offset": 22, "parentSeq": null, "seq": 1, "text": "二千三百七十四分, 秒四少.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0010", "id": null, "offset": 59, "parentSeq": null, "seq": 2, "text": "漢 太山郡 山茌縣, 屬齊州西南之界.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0010", "id": null, "offset": 66, "parentSeq": null, "seq": 3, "text": "漢 高密國, 今在密州北界. 自此以上, 玄枵之分.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0010", "id": null, "offset": 74, "parentSeq": null, "seq": 4, "text": "漢之東萊郡及膠東國, 今爲萊州·登州也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0010", "id": null, "offset": 94, "parentSeq": null, "seq": 5, "text": "今爲淄·靑·齊等州, 及濟州東界.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0010", "id": null, "offset": 117, "parentSeq": null, "seq": 6, "text": "今爲德州·棣州, 滄州其北界.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0020", "id": null, "offset": 21, "parentSeq": null, "seq": 1, "text": "二千五百四十九分, 秒八太.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0020", "id": null, "offset": 27, "parentSeq": null, "seq": 2, "text": "一百七十四分半.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0020", "id": null, "offset": 82, "parentSeq": null, "seq": 3, "text": "今爲洺·趙·邢·恆·定·冀·貝·深八州. 又分相·魏·博之北界, 與瀛州之西, 全趙之分.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0030", "id": null, "offset": 23, "parentSeq": null, "seq": 1, "text": "八百四十一分, 十五太.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0030", "id": null, "offset": 29, "parentSeq": null, "seq": 2, "text": "一千五百二十六,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0030", "id": null, "offset": 49, "parentSeq": null, "seq": 3, "text": "今爲蒲·絳·晉州, 又得澤州及慈州界也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0030", "id": null, "offset": 54, "parentSeq": null, "seq": 4, "text": "今爲澤·潞·儀·沁也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0030", "id": null, "offset": 58, "parentSeq": null, "seq": 5, "text": "今爲幷·汾州.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0030", "id": null, "offset": 65, "parentSeq": null, "seq": 6, "text": "今爲隰州·石州·嵐州, 西涉河, 得銀州以北也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0030", "id": null, "offset": 81, "parentSeq": null, "seq": 7, "text": "今河東郡 永樂·芮城·河北縣及河曲 豐·勝·夏州, 皆爲實沈之次, 東井之分也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0040", "id": null, "offset": 24, "parentSeq": null, "seq": 1, "text": "二千一百七十二秒, 十五太.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0040", "id": null, "offset": 32, "parentSeq": null, "seq": 2, "text": "二千八百二十八分, 秒一半.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0040", "id": null, "offset": 116, "parentSeq": null, "seq": 3, "text": "鶉首之分, 得禹貢 雍·梁二州, 其郡縣易知, 故不詳載.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0040", "id": null, "offset": 145, "parentSeq": null, "seq": 4, "text": "今之西羌·吐蕃·蕃渾, 及西南徼外夷, 皆狼星之象.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0050", "id": null, "offset": 21, "parentSeq": null, "seq": 1, "text": "一千七百九十五, 秒二十二少.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0050", "id": null, "offset": 28, "parentSeq": null, "seq": 2, "text": "二千四百六十一, 秒八半.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0050", "id": null, "offset": 56, "parentSeq": null, "seq": 3, "text": "南郡: 巫縣, 今在蘷州. 秭歸在西, 夷陵在峽州. 襄·蘷·郢·申在襄·郢界, 餘爲荊州.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0050", "id": null, "offset": 60, "parentSeq": null, "seq": 4, "text": "江夏: 竟陵今爲復州, 安·鄂·蘄·沔·黃五州, 皆漢江夏界.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0050", "id": null, "offset": 68, "parentSeq": null, "seq": 5, "text": "漢 廬江之尋陽, 今在江州, 於山河之像, 宜屬鶉尾也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0050", "id": null, "offset": 92, "parentSeq": null, "seq": 6, "text": "零陵今爲道州·永州. 桂陽今爲郴州. 大抵自沅·湘上流, 西通黔安之左, 皆楚之分也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0050", "id": null, "offset": 108, "parentSeq": null, "seq": 7, "text": "鬱林縣今在貴州. 定林縣今在廉州. 合浦縣今爲桂州. 今自富·昭·蒙·龔·繡·容·白·罕八州以西, 皆屬鶉尾之墟也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0050", "id": null, "offset": 164, "parentSeq": null, "seq": 8, "text": "今安南諸州, 在雲漢上源之東, 宜屬鶉火.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0060", "id": null, "offset": 21, "parentSeq": null, "seq": 1, "text": "二千七百五十分, 秒二十一少.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0060", "id": null, "offset": 28, "parentSeq": null, "seq": 2, "text": "三百七十分, 秒六十七.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0060", "id": null, "offset": 61, "parentSeq": null, "seq": 3, "text": "漢 渤海郡 浮陽, 今爲淸池縣, 屬滄州. 涿郡之饒陽, 今屬瀛州. 涿縣·良鄕與廣陽國 薊縣, 今在幽州.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0060", "id": null, "offset": 82, "parentSeq": null, "seq": 4, "text": "漁陽在幽州. 右北平在白狼 無終縣, 隋代爲漁陽郡, 古孤竹國, 後置北平郡, 今爲平州. 遼東在無慮縣, 卽周禮 醫無閭山. 樂浪在朝鮮縣, 玄菟在高句驪縣, 今皆在東夷也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0070", "id": null, "offset": 23, "parentSeq": null, "seq": 1, "text": "一千四十二十分, 秒二太.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0070", "id": null, "offset": 31, "parentSeq": null, "seq": 2, "text": "一千一百分, 秒八半.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0070", "id": null, "offset": 71, "parentSeq": null, "seq": 3, "text": "廬·壽·和·濠·揚, 皆屬星紀也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0070", "id": null, "offset": 111, "parentSeq": null, "seq": 4, "text": "又逾嶺表, 自韶·廣·封·梧·藤·羅·雷州, 南及珠崖自北以東爲星紀, 其西皆屬鶉尾之次.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0340_0070", "id": null, "offset": 211, "parentSeq": null, "seq": 5, "text": "李淳風刊定隋志, 郡國頗爲詳悉, 所注郡邑多依用. 其後州縣又隸管屬不同, 但據山河以分耳.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0030", "id": null, "offset": 68, "parentSeq": null, "seq": 1, "text": "凡節度使十, 經略守捉使三.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0030", "id": null, "offset": 123, "parentSeq": null, "seq": 2, "text": "開元已前, 每年邊用不過二百萬, 天寶中至於是數.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0040", "id": null, "offset": 30, "parentSeq": null, "seq": 1, "text": "安西都護府治所, 在龜茲國城內, 管戍兵二萬四千人, 馬二千七百疋, 衣賜六十二萬疋段. 焉耆治所, 在安西府東八百里. 于闐, 在安西府南二千里. 疏勒, 在安西府西二千餘里.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0040", "id": null, "offset": 63, "parentSeq": null, "seq": 2, "text": "北庭節度使所治, 在北庭都護府, 管兵二萬人, 馬五千疋, 衣賜四十八萬疋段. 突騎施牙帳, 在北庭府西北三千餘里. 堅昆, 在北庭府北七千里. 東北去斬啜千七百里. 瀚海軍, 在北庭府城內, 管兵萬二千人, 馬四千二百疋. 天山軍, 在西州城內, 管兵五千人, 馬五百疋. 伊吾軍, 在伊州西北三百里甘露川, 管兵三千人, 馬三百疋.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0040", "id": null, "offset": 118, "parentSeq": null, "seq": 3, "text": "河西節度使治, 在涼州, 管兵七萬三千人, 馬萬九千四百疋, 衣賜歲百八十萬疋段. 赤水軍, 在涼州城內, 管兵三萬三千人, 馬萬三千疋. 大斗軍, 在涼州西二百餘里, 管兵七千五百人, 馬二千四百疋. 建康軍, 在甘州西二百里, 管兵五千三百人, 馬五百疋. 寧寇軍, 在涼州東北千餘里. 玉門軍, 在肅州西二百里, 管兵五千二百人, 馬六百疋. 墨離軍, 在瓜州西北千里, 管兵五千人, 馬四百疋. 豆盧軍, 在沙州城內, 管兵四千三百人, 馬四百疋. 新泉軍, 在會州西北二百餘里, 管兵千人. 張掖守捉, 在涼州南二里, 管兵五百人. 交城守捉, 在涼州西二百里, 管兵千人. 白亭守捉, 在涼州西北五百里, 管兵千七百人.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0040", "id": null, "offset": 164, "parentSeq": null, "seq": 4, "text": "朔方節度使, 治靈州, 管兵六萬四千七百人, 馬四千三百疋, 衣賜二百萬疋段. 經略軍, 理靈州城內, 管兵二萬七百人, 馬三千疋. 豐安軍, 在靈州西黃河外百八十里, 管兵八千人, 馬千三百疋. 定遠城, 在靈州東北二百里黃河外, 管兵七千人, 馬三千疋. 西受降城, 在豐州北黃河外八十里, 管兵七千人, 馬千七百疋. 安北都護府治, 在中受降城 黃河北岸, 管兵六千人, 馬二千疋. 東受降城, 在勝州東北二百里, 管兵七千人, 馬千七百疋. 振武軍, 在單于東都護府城內, 管兵九千人, 馬千六百疋.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0040", "id": null, "offset": 215, "parentSeq": null, "seq": 5, "text": "河東節度使, 治太原府, 管兵五萬五千人, 馬萬四千疋, 衣賜歲百二十六萬疋段, 軍糧五十萬石. 天兵軍, 理太原府城內, 管兵三萬人, 馬五千五百疋. 雲中守捉, 在單于府西北二百七十里, 管兵七千七百人, 馬二千疋. 大同軍, 在代州北三百里, 管兵九千五百人, 馬五千五百疋. 橫野軍, 在蔚州東北一百四十里, 管兵三千人, 馬千八百疋. 忻州, 在太原府北百八十里, 管兵七千八百人. 代州, 至太原府五百里, 管兵四千人. 嵐州, 在太原府西北二百五十里, 管兵三千人. 岢嵐軍, 在嵐州北百里, 管兵一千人.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0040", "id": null, "offset": 262, "parentSeq": null, "seq": 6, "text": "范陽節度使, 理幽州, 管兵九萬一千四百人, 馬六千五百疋, 衣賜八十萬疋段, 軍糧五十萬石. 經略軍, 在幽州城內, 管軍三萬人, 馬五千四百疋. 威武軍, 在檀州城內, 管兵萬人, 馬三百疋. 淸夷軍, 在嬀州城內, 管兵萬人, 馬三百疋. 靜塞軍, 在薊州城內, 管兵萬六千人, 馬五百疋. 恆陽軍, 在恆州城東, 管兵三千五百人. 北平軍, 在定州城西, 管兵六千人. 高陽軍, 在易州城內, 管兵六千人. 唐興軍, 在莫州城內, 管兵六千人. 橫海軍, 在滄州城內, 管兵六千人.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0040", "id": null, "offset": 302, "parentSeq": null, "seq": 7, "text": "平盧軍節度使治, 在營州, 管兵萬七千五百人, 馬五千五百疋. 平盧軍, 在營州城內, 管兵萬六千人, 馬四千二百疋. 盧龍軍, 在平州城內, 管兵萬人, 馬三百疋. 楡關守捉, 在營州城西四百八十里, 管兵三百人, 馬百疋. 安東都護府, 在營州東二百七十里, 管兵八千五百人, 馬七百疋.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0040", "id": null, "offset": 363, "parentSeq": null, "seq": 8, "text": "隴右節度使, 在鄯州, 管兵七萬人, 馬六百疋, 衣賜二百五十萬疋段. 臨洮軍, 在鄯州城內, 管兵萬五千人, 馬八千疋. 河源軍, 在鄯州西百二十里, 管兵四千人, 馬六百五十疋. 白水軍, 在鄯州西北二百三十里, 管兵四千人, 馬五百疋. 安人軍, 在鄯州界星宿川西, 兵萬人, 馬三百五十疋. 振威軍, 在鄯州西三百里, 管兵千人, 馬五百疋. 威戎軍, 在鄯州西北三百五十里, 管兵千人, 馬五十疋. 綏和守捉, 在鄯州西南二百五十里, 管兵千人. 合川守捉, 在鄯州南百八十里, 管兵千人. 莫門軍, 在洮州城內, 管兵五千五百人, 馬二百疋. 寧塞軍, 在廓州城內, 管兵五百人, 馬五十疋. 積石軍, 在廓州西百八十里, 管兵七千人, 馬三百疋. 鎭西軍, 在河州城內, 管兵萬一千人, 馬三百疋. 平夷守捉, 在河州西南四十里, 管兵三千人.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0040", "id": null, "offset": 432, "parentSeq": null, "seq": 9, "text": "劍南節度使治, 在成都府, 管兵三萬九百人, 馬二千疋, 衣賜八十萬疋段, 軍糧七十萬石. 團結營, 在成都府城內, 管兵萬四千人, 馬千八百疋. 翼州, 管兵五百人. 茂州, 管兵三百人. 維州, 管兵五百人. 天寶軍, 在恭州東南九十里, 管兵千人. 柘州, 管兵五百人. 松州, 管兵二千八百人. 平戎城, 在恭州南八十里, 管兵千人. 雅州, 管兵四百人. 當州, 管兵五百人. 黎州, 管兵千人. 昆明軍, 在嶲州南, 管兵五千一百人, 馬二百疋. 寧遠城, 在嶲州西, 管兵三百人. 姚州, 管兵三百人. 澄川守捉, 在姚州東六百里, 管兵二千人, 悉州, 管兵五千人. 南江郡, 管兵三百人.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0040", "id": null, "offset": 474, "parentSeq": null, "seq": 10, "text": "五府經略使治, 在廣州, 管兵萬五千四百人, 輕稅本鎭以自給. 經略軍, 在廣州城內, 管兵五千四百人. 淸海軍, 在恩州城內, 管兵二千人. 桂管經略使, 治桂州, 管兵千人. 容管經略使, 治容州, 管兵千一百人. 安南經略使, 治安南都護府, 卽交州, 管兵四千二百人. 邕管經略使, 管兵七百人.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0360_0050", "id": null, "offset": 70, "parentSeq": null, "seq": 1, "text": "漢地東至樂浪·玄菟, 今高麗·渤海是也. 今在遼東, 非唐土也. 漢境西至燉煌郡, 今沙州, 是唐土. 又龜茲, 是西過漢之盛也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0370_0080", "id": null, "offset": 166, "parentSeq": null, "seq": 1, "text": "寰宇記卷七一作 「領靺鞨, 本粟末靺鞨別種.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0390_0010", "id": null, "offset": 537, "parentSeq": null, "seq": 1, "text": "音拳", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0010", "id": null, "offset": 16, "parentSeq": null, "seq": 1, "text": "從五品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0010", "id": null, "offset": 23, "parentSeq": null, "seq": 2, "text": "從六品上. 郎中·員外, 自隋已來, 隨曹改易.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0010", "id": null, "offset": 162, "parentSeq": null, "seq": 3, "text": "從五品上. 龍朔爲司珍大夫, 咸亨復.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0010", "id": null, "offset": 169, "parentSeq": null, "seq": 4, "text": "從六品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0020", "id": null, "offset": 16, "parentSeq": null, "seq": 1, "text": "從五品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0020", "id": null, "offset": 23, "parentSeq": null, "seq": 2, "text": "從六品上. 隋曰儀曹郎, 武德改禮部郎中員外, 龍朔爲司禮大夫司禮員外, 咸亨復.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0020", "id": null, "offset": 106, "parentSeq": null, "seq": 3, "text": "從五品上. 隋曰司蕃郎, 武德改主客郎中, 龍朔爲司蕃大夫, 咸亨復.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0020", "id": null, "offset": 112, "parentSeq": null, "seq": 4, "text": "從六品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0020", "id": null, "offset": 118, "parentSeq": null, "seq": 5, "text": "從九品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0030", "id": null, "offset": 16, "parentSeq": null, "seq": 1, "text": "從五品上. 龍朔爲司戎大夫, 咸亨復也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0030", "id": null, "offset": 23, "parentSeq": null, "seq": 2, "text": "從六品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0030", "id": null, "offset": 29, "parentSeq": null, "seq": 3, "text": "從八品下.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0030", "id": null, "offset": 150, "parentSeq": null, "seq": 4, "text": "從五品上. 龍朔爲司域大夫也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0030", "id": null, "offset": 157, "parentSeq": null, "seq": 5, "text": "正六品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0030", "id": null, "offset": 163, "parentSeq": null, "seq": 6, "text": "從九品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0040", "id": null, "offset": 18, "parentSeq": null, "seq": 1, "text": "從五品上. 龍朔爲司計大夫.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0040", "id": null, "offset": 25, "parentSeq": null, "seq": 2, "text": "從六品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0040", "id": null, "offset": 31, "parentSeq": null, "seq": 3, "text": "從九品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0040", "id": null, "offset": 200, "parentSeq": null, "seq": 4, "text": "從五品上. 龍朔曰司門大夫.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0040", "id": null, "offset": 207, "parentSeq": null, "seq": 5, "text": "從六品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0040", "id": null, "offset": 213, "parentSeq": null, "seq": 6, "text": "從九品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0050", "id": null, "offset": 151, "parentSeq": null, "seq": 1, "text": "從六品上. 周有典瑞之職, 秦有符璽令, 漢曰符璽郎. 兩漢得秦六璽及傳國璽, 後代傳之. 隋置符璽郎二員, 從六品. 天后惡璽字, 改爲寶. 其受命傳國等八璽文, 並改彫寶字. 神龍初, 復爲符璽郎. 開元初, 又改爲符寶, 從璽文也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0060", "id": null, "offset": 15, "parentSeq": null, "seq": 1, "text": "漢置中書, 掌密詔, 有令·僕·丞·郎四官. 魏曰中書郎, 晉加「侍」字. 隋置內書省, 改爲內書侍郞, 正四品. 武德初爲內史侍郞, 三年改爲中書侍郞. 龍朔·光宅·開元, 隨曹易號. 至德復爲中書侍郞. 武德定令, 與尙書侍郞俱第四品. 大曆二年九月, 與門下侍郞共升爲正三品也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0410_0060", "id": null, "offset": 123, "parentSeq": null, "seq": 2, "text": "從六品上. 通事舍人, 秦謁者之官也. 掌賓贊·贊受事, 隸光祿勳. 晉置舍人·通事各一人, 隸中書. 東晉曰通事舍人. 隋因晉制, 置十六人, 從六品上, 又爲通事謁者. 武德初, 廢謁者臺, 改通事謁者爲通事舍人, 隸四方館, 屬中書省也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0010", "id": null, "offset": 17, "parentSeq": null, "seq": 1, "text": "正八品下.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0010", "id": null, "offset": 22, "parentSeq": null, "seq": 2, "text": "正九品下.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0020", "id": null, "offset": 6, "parentSeq": null, "seq": 1, "text": "周曰大行人, 秦曰典客, 漢景帝曰大行, 武帝曰大鴻臚. 梁置十二卿, 鴻臚爲冬卿, 去大字, 署爲寺. 後周曰賓部, 隋曰鴻臚寺. 龍朔改爲同文寺, 光宅曰司賓寺, 神龍復也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0020", "id": null, "offset": 11, "parentSeq": null, "seq": 2, "text": "從三品.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0020", "id": null, "offset": 17, "parentSeq": null, "seq": 3, "text": "從四品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0020", "id": null, "offset": 150, "parentSeq": null, "seq": 4, "text": "從七品下.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0020", "id": null, "offset": 155, "parentSeq": null, "seq": 5, "text": "從八品下.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0020", "id": null, "offset": 162, "parentSeq": null, "seq": 6, "text": "正九品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 14, "parentSeq": null, "seq": 1, "text": "從二品.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 21, "parentSeq": null, "seq": 2, "text": "正四品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 27, "parentSeq": null, "seq": 3, "text": "正五品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 33, "parentSeq": null, "seq": 4, "text": "正五品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 42, "parentSeq": null, "seq": 5, "text": "正七品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 48, "parentSeq": null, "seq": 6, "text": "從九品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 71, "parentSeq": null, "seq": 7, "text": "並正七品下.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 78, "parentSeq": null, "seq": 8, "text": "正八品下.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 90, "parentSeq": null, "seq": 9, "text": "正三品.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 97, "parentSeq": null, "seq": 10, "text": "從四品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 103, "parentSeq": null, "seq": 11, "text": "正五品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 109, "parentSeq": null, "seq": 12, "text": "正五品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 118, "parentSeq": null, "seq": 13, "text": "正七品下.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 144, "parentSeq": null, "seq": 14, "text": "從七品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0030", "id": null, "offset": 151, "parentSeq": null, "seq": 15, "text": "從八品上.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0040", "id": null, "offset": 6, "parentSeq": null, "seq": 1, "text": "天寶中, 緣邊禦戎之地, 置八節度使. 受命之日, 賜之旌節, 謂之節度使, 得以專制軍事. 行則建節符, 樹六纛. 外任之重, 無比焉. 至德已後, 天下用兵, 中原刺史亦循其例, 受節度使之號.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0040", "id": null, "offset": 44, "parentSeq": null, "seq": 2, "text": "無員數也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0420_0040", "id": null, "offset": 50, "parentSeq": null, "seq": 3, "text": "皆天寶後置. 檢討未見品秩.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0440_0010", "id": null, "offset": 8, "parentSeq": null, "seq": 1, "text": "釋智猛撰.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0440_0010", "id": null, "offset": 15, "parentSeq": null, "seq": 2, "text": "釋法盛撰.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0440_0010", "id": null, "offset": 22, "parentSeq": null, "seq": 3, "text": "沈懷遠撰.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0440_0010", "id": null, "offset": 36, "parentSeq": null, "seq": 4, "text": "梁元帝撰.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0440_0010", "id": null, "offset": 64, "parentSeq": null, "seq": 5, "text": "宋雲撰.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0440_0010", "id": null, "offset": 101, "parentSeq": null, "seq": 6, "text": "常駿等撰.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0440_0010", "id": null, "offset": 109, "parentSeq": null, "seq": 7, "text": "裴矩撰.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0440_0010", "id": null, "offset": 119, "parentSeq": null, "seq": 8, "text": "王玄策撰.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0600_0010", "id": null, "offset": 31, "parentSeq": null, "seq": 1, "text": "永徽四年 「四年」各本原作 「二年」, 據本書卷四高宗紀·通鑑卷一九九改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0630_0020", "id": null, "offset": 141, "parentSeq": null, "seq": 1, "text": "男生 各本原作 「男産」, 與後文 「虜其王高藏及男建·男産」 有矛盾, 據本書卷一九九上高麗傳·册府卷九八六·通鑑卷二○一改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0710_0010", "id": null, "offset": 124, "parentSeq": null, "seq": 1, "text": "遼水二千餘里 校勘記卷三七云: 「據文義, 『遼』上當有『至』字.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0760_0030", "id": null, "offset": 581, "parentSeq": null, "seq": 1, "text": "高侃 「侃」字各本原無, 據新書卷一一一薛仁貴傳, 通鑑卷二○一補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0760_0030", "id": null, "offset": 1103, "parentSeq": null, "seq": 2, "text": "漠北 各本原作 「漢北」, 册府卷七八作「漠北」, 舊唐書補校云: 「『漢』當作『漠』.」 據改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0790_0010", "id": null, "offset": 274, "parentSeq": null, "seq": 1, "text": "令總沒官 「令」字各本原作「今」, 據册府卷二六一改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0910_0010", "id": null, "offset": 115, "parentSeq": null, "seq": 1, "text": "可突干 「干」字各本原作「于」, 據本書卷八玄宗紀, 通鑑卷二一三改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0920_0010", "id": null, "offset": 926, "parentSeq": null, "seq": 1, "text": "不取汝城 「不」字各本原作「吾」. 校勘記卷四一引閣本考證云: 「刊本 『不』訛 『吾』.」 新書卷一三五高仙芝傳作「不闚若城」. 據改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0930_0020", "id": null, "offset": 744, "parentSeq": null, "seq": 1, "text": "北門四軍 各本原作 「北四門軍」, 據合鈔卷一五七王毛仲傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0950_0020", "id": null, "offset": 279, "parentSeq": null, "seq": 1, "text": "莫離支男生 「離」字各本原無, 據册府卷四二０補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0950_0020", "id": null, "offset": 637, "parentSeq": null, "seq": 2, "text": "男建, 殘宋本作「勇建」, 殿·局·廣本作「勇健」, 據册府卷三五八·通鑑卷二０一改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0960_0020", "id": null, "offset": 207, "parentSeq": null, "seq": 1, "text": "吐蕃蘇毗王款塞 「吐蕃」, 殘宋本作「吐蕃渾」, 餘各本均作「吐谷渾」. 按蘇毗爲吐蕃滅後, 卽附屬于吐蕃. 通鑑卷二一七云: 「蘇毗王子悉諾邏去吐蕃來降.」 此據殘宋本, 並刪「渾」字.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0960_0020", "id": null, "offset": 651, "parentSeq": null, "seq": 2, "text": "先入景淸宮 册府卷三八五作 「先入宮」, 新書卷一四七王思禮傳作 「先入淸宮」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0990_0010", "id": null, "offset": 20, "parentSeq": null, "seq": 1, "text": "靺鞨 各本原作「靺羯」, 據本書卷一九九下靺鞨傳·新書卷二二四上李懷光傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_0990_0010", "id": null, "offset": 42, "parentSeq": null, "seq": 2, "text": "父常爲朔方列將 「父」字各本原無, 據新書卷二二四上李懷光傳補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1040_0010", "id": null, "offset": 94, "parentSeq": null, "seq": 1, "text": "仙芝大衄 「仙芝」各本原作「靈察」, 據新書卷一五三段秀實傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1060_0010", "id": null, "offset": 42, "parentSeq": null, "seq": 1, "text": "司徒徒何弼 各本原作「司徒何弼」, 據北史卷六○李弼傳補「徒」字.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1060_0010", "id": null, "offset": 417, "parentSeq": null, "seq": 2, "text": "粤在澧陽 「粤」字各本原作「奧」, 據册府卷六七一改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1080_0010", "id": null, "offset": 197, "parentSeq": null, "seq": 1, "text": "於是擧部內鄕兵 「兵」字各本原無, 據册府卷四一三補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1120_0010", "id": null, "offset": 896, "parentSeq": null, "seq": 1, "text": "東郡 各本原作「東都」, 據册府卷五六０·全唐文卷三九四改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1120_0010", "id": null, "offset": 1143, "parentSeq": null, "seq": 2, "text": "北地 各本原作「十地」, 據册府卷五六０·全唐文卷三九四改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1140_0010", "id": null, "offset": 151, "parentSeq": null, "seq": 1, "text": "孫知古 「古」字各本原作「在」, 據册府卷四三九, 唐大詔令集卷一一九·全唐文卷四七改. 下同.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1160_0030", "id": null, "offset": 28, "parentSeq": null, "seq": 1, "text": "貞元元年 「元年」各本原作「二年」, 據本卷上下文改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1170_0010", "id": null, "offset": 89, "parentSeq": null, "seq": 1, "text": "安西節度使 「安西」, 各本原作「西安」, 據本書卷一０四高仙芝傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1180_0010", "id": null, "offset": 21, "parentSeq": null, "seq": 1, "text": "武陟 各本原作「武涉」, 據本書卷三九地理志改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1180_0010", "id": null, "offset": 351, "parentSeq": null, "seq": 2, "text": "黑水 各本原作「墨水」, 據新書卷四三下地理志改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1200_0020", "id": null, "offset": 311, "parentSeq": null, "seq": 1, "text": "兗 海 沂 密等州節度 「兗」字各本原作「充」, 據新書卷一七０高崇文傳·通鑑卷二四二改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1220_0010", "id": null, "offset": 161, "parentSeq": null, "seq": 1, "text": "圍之半日 「日」字各本原作「月」, 據本書卷一二四李正己傳·册府卷六九五改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1270_0010", "id": null, "offset": 142, "parentSeq": null, "seq": 1, "text": "今與其子女 「與」字各本原無, 據唐會要卷三九·册府卷一五○補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1290_0020", "id": null, "offset": 188, "parentSeq": null, "seq": 1, "text": "北州兵稍厚 「北」字各本原作「此」, 通鑑卷二四一作「天子以鄆人有遷徙之勞, 特加優給」. 時曹華治所在沂州, 鄆州不得稱「此州」. 册府卷四○一作「北州」, 以鄆州於沂 海 兗爲北, 是也, 今據改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1460_0040", "id": null, "offset": 300, "parentSeq": null, "seq": 1, "text": "大和 各本原作「元和」, 據新書卷一九三賈直言傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1510_0040", "id": null, "offset": 370, "parentSeq": null, "seq": 1, "text": "漢陽公瓌　「瓌」上各本原有「蘇」字, 據本書卷六０漢陽王瓌傳·册府卷九八０刪.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1510_0040", "id": null, "offset": 2058, "parentSeq": null, "seq": 2, "text": "幽州　通鑑卷一九一同, 胡注云: 「幽州當作豳州.」 合鈔卷二五五突厥傳作豳州.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1510_0040", "id": null, "offset": 2540, "parentSeq": null, "seq": 3, "text": "二年 各本原作「三年」, 通典卷一九七·寰宇記卷一九五均作「二年」. 且下文旣又有「三年」, 此處當以作「二年」爲是, 據改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1510_0070", "id": null, "offset": 1271, "parentSeq": null, "seq": 1, "text": "及拔塞匐處木昆　「及」字各本原作 「乃」, 據寰宇記卷一九六改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1510_0100", "id": null, "offset": 48, "parentSeq": null, "seq": 1, "text": "長壽二年　通典卷一九八·寰宇記卷一九六均作 「長壽三年」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1510_0100", "id": null, "offset": 1222, "parentSeq": null, "seq": 2, "text": "安北大都護　「護」字各本原作「督」, 據新書卷二一五上突厥傳·通鑑卷二０七改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1510_0100", "id": null, "offset": 1285, "parentSeq": null, "seq": 3, "text": "平恩王重俊 義興王重明　按本書卷八六中宗諸子傳, 平恩王當爲重福, 義興王當爲重俊, 史文當有訛誤.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1520_0070", "id": null, "offset": 507, "parentSeq": null, "seq": 1, "text": "觸木昆 「木」字各本原作「水」, 據通典卷一九九·寰宇記卷一九七改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1520_0100", "id": null, "offset": 34, "parentSeq": null, "seq": 1, "text": "自知不爲衆所附,　通典卷一九九·寰宇記卷一九七, 「自」上有「大敗之咄陸」五字.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1520_0110", "id": null, "offset": 880, "parentSeq": null, "seq": 1, "text": "詐將酒食出迎「詐」字各本原作「許」, 據通典卷一九九·寰宇記卷一九七改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1520_0120", "id": null, "offset": 86, "parentSeq": null, "seq": 1, "text": "彌射在本蕃爲莫賀咄葉護　「彌射」二字各本原無, 據通典卷一九九·寰宇記卷一九七補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1520_0150", "id": null, "offset": 133, "parentSeq": null, "seq": 1, "text": "金河公主　通典卷一九九·寰宇記卷一九七同. 唐會要卷六·新書卷二一五下突厥傳作「交河公主」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1520_0150", "id": null, "offset": 523, "parentSeq": null, "seq": 2, "text": "東附突厥　「東」字各本原無, 據通典卷一九九·寰宇記卷一九七補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1550_0010", "id": null, "offset": 1705, "parentSeq": null, "seq": 1, "text": "姓泉氏 「泉」字各本原作「錢」, 據御覽卷七八三·新書卷二二○高麗傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1550_0010", "id": null, "offset": 5066, "parentSeq": null, "seq": 2, "text": "總章元年, 「元年」各本原作「九年」, 總章共兩年, 作「九年」誤, 據通鑑卷二○一改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1560_0010", "id": null, "offset": 1083, "parentSeq": null, "seq": 1, "text": "去歲王及高麗 新羅等使並來入朝 「及」字各本原作「攻」, 據全唐文卷一五改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1560_0010", "id": null, "offset": 2455, "parentSeq": null, "seq": 2, "text": "杜爽 「杜」字各本原作「社」, 據本書卷八四劉仁軌傳·通鑑卷二○一改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1570_0010", "id": null, "offset": 921, "parentSeq": null, "seq": 1, "text": "文王 「王」字各本原作「正」, 據册府卷九七四·新書卷二二○新羅傳改. 下同.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1570_0010", "id": null, "offset": 1020, "parentSeq": null, "seq": 2, "text": "遣其弟法敏以聞 本卷下文云法敏爲眞德弟春秋之子, 新書卷二二○新羅傳作「遣春秋子法敏入朝」. 張森楷謂此句「弟」下當脫一「子」字.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1570_0010", "id": null, "offset": 1154, "parentSeq": null, "seq": 3, "text": "七曜 「七」字各本原作「十」, 據御覽卷七八一改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1570_0010", "id": null, "offset": 1661, "parentSeq": null, "seq": 4, "text": "先天中則天改焉 按先天時則天已卒, 此處有誤.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1570_0010", "id": null, "offset": 2433, "parentSeq": null, "seq": 5, "text": "重興立 「立」字各本原作「無」, 據唐會要卷九五·册府卷九六五改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1570_0010", "id": null, "offset": 3109, "parentSeq": null, "seq": 6, "text": "鴻臚寺奏 「奏」字各本原無, 據唐會要卷九五補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1590_0010", "id": null, "offset": 439, "parentSeq": null, "seq": 1, "text": "鎭南都護 新書卷二二○東夷傳作「安南都護」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1590_0010", "id": null, "offset": 460, "parentSeq": null, "seq": 2, "text": "橘逸勢 「逸」字各本原作「免」, 據日本續羣書類叢傳部橘逸勢傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1600_0010", "id": null, "offset": 540, "parentSeq": null, "seq": 1, "text": "俱倫水 「水」字各本原作「山」, 據通典卷一九九·寰宇記卷一九八改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1600_0010", "id": null, "offset": 623, "parentSeq": null, "seq": 2, "text": "大罪者斬之小罪者鞭之 「斬之小罪者」五字各本原無, 據通鑑卷一九三補. 唐會要卷九六作「大罪斬之, 小罪鞭之」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1600_0010", "id": null, "offset": 1331, "parentSeq": null, "seq": 3, "text": "泥熟俟斤 各本原作「泥敦策斤」, 據册府卷九七八·通鑑卷一九六改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1600_0010", "id": null, "offset": 1989, "parentSeq": null, "seq": 4, "text": "十九年 各本原作「十七年」, 據本書卷三太宗紀及卷一九九高麗傳·通鑑卷一九八改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1600_0010", "id": null, "offset": 2726, "parentSeq": null, "seq": 5, "text": "金微 「微」字各本原作「徽」, 據本書卷一九四上突厥傳·寰宇記卷一九六·新書卷四三下地理志·册府卷一二改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1600_0010", "id": null, "offset": 2755, "parentSeq": null, "seq": 6, "text": "胡祿俟利發 「胡」字各本原作「月」, 據唐大詔令集卷七九·册府卷一二改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1600_0010", "id": null, "offset": 2922, "parentSeq": null, "seq": 7, "text": "獨能宣力 「宣力」二字各本原無, 據唐大詔令集卷七九·册府卷一二補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1600_0010", "id": null, "offset": 3235, "parentSeq": null, "seq": 8, "text": "二十一年 各本原作「二十二年」, 據通典卷一九八改. 突厥集史: 「二十二爲二十一訛. 下文云是歲大酺, 元龜八○固在二十一年正月甲寅也.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1610_0010", "id": null, "offset": 12, "parentSeq": null, "seq": 1, "text": "潢水 各本原作「黃水」, 據唐會要卷九六·新書卷二一九契丹傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1610_0010", "id": null, "offset": 926, "parentSeq": null, "seq": 2, "text": "在陣陷沒 「在」字各本原作「左」, 據册府卷九八六改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1610_0010", "id": null, "offset": 1408, "parentSeq": null, "seq": 3, "text": "可突于 通鑑卷二一二·合鈔卷二五九下北狄傳作「可突干」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1610_0010", "id": null, "offset": 1474, "parentSeq": null, "seq": 4, "text": "李大輔 唐會要卷九六·通鑑卷二一一皆作「李大酺」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1610_0010", "id": null, "offset": 1534, "parentSeq": null, "seq": 5, "text": "鬱于 唐會要卷九六作「鬱於」, 通鑑卷二一二作「鬱干」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1610_0010", "id": null, "offset": 1687, "parentSeq": null, "seq": 6, "text": "吐于 通鑑卷二一二作「吐干」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1610_0010", "id": null, "offset": 2315, "parentSeq": null, "seq": 7, "text": "管記王悔等 「記」字各本原作「紀」, 據本書卷一○三張守珪傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1610_0010", "id": null, "offset": 2682, "parentSeq": null, "seq": 8, "text": "契丹新立王屈戍 「王」字各本原作「五」, 據唐會要卷九六改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1620_0010", "id": null, "offset": 365, "parentSeq": null, "seq": 1, "text": "孫儉 新書卷二一九北狄傳·通鑑卷二一○作「孫佺」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1620_0010", "id": null, "offset": 690, "parentSeq": null, "seq": 2, "text": "姜師度 「姜」字各本原作「羊」, 據通鑑卷二一一改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1630_0010", "id": null, "offset": 923, "parentSeq": null, "seq": 1, "text": "大都督 「都」字各本原作「勝」, 據唐會要卷九六·册府卷九七二改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1640_0010", "id": null, "offset": 733, "parentSeq": null, "seq": 1, "text": "安居骨 號室等部 「號」字各本原無, 據通典卷一八六·寰宇記卷一九五補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1640_0010", "id": null, "offset": 789, "parentSeq": null, "seq": 2, "text": "部又以南北爲稱 「稱」字各本原作「柵」, 據唐會要卷九六·合鈔卷二五九下北狄傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1650_0010", "id": null, "offset": 195, "parentSeq": null, "seq": 1, "text": "桂婁 新書卷二一九北狄傳作「挹婁」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1650_0010", "id": null, "offset": 288, "parentSeq": null, "seq": 2, "text": "南與新羅相接越憙靺鞨東北至黑水靺鞨 册府卷九五九作「南與新羅相接, 西接越憙靺鞨, 東北至黑水靺鞨.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_034_ko_034_1650_0010", "id": null, "offset": 1490, "parentSeq": null, "seq": 3, "text": "進封渤海國王 各本原作「進封渤海郡王」, 據下文及册府卷九六五改.", "type": "원주"}
