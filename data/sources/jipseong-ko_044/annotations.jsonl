{"chunkId": "chunk_jipseong-ko_044_ko_044_0200_0020", "id": null, "offset": 37, "parentSeq": null, "seq": 1, "text": "省事, 郡吏也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0230_0010", "id": null, "offset": 143, "parentSeq": null, "seq": 1, "text": "●(渦/水)音過,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0260_0020", "id": null, "offset": 641, "parentSeq": null, "seq": 1, "text": "女耕切, 困也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0260_0030", "id": null, "offset": 478, "parentSeq": null, "seq": 1, "text": "福信 扶餘舊將無始.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0340_0010", "id": null, "offset": 57, "parentSeq": null, "seq": 1, "text": "鮮卑名也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0430_0010", "id": null, "offset": 70, "parentSeq": null, "seq": 1, "text": "遼東兵多也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0440_0010", "id": null, "offset": 240, "parentSeq": null, "seq": 1, "text": "高麗之君.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0490_0010", "id": null, "offset": 109, "parentSeq": null, "seq": 1, "text": "幸親於天子.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0490_0010", "id": null, "offset": 199, "parentSeq": null, "seq": 2, "text": "與樓船爲要約, 而請降.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0490_0010", "id": null, "offset": 278, "parentSeq": null, "seq": 3, "text": "意疑也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0490_0010", "id": null, "offset": 345, "parentSeq": null, "seq": 4, "text": "顓與專同, 卒終也. 沮壞也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0490_0010", "id": null, "offset": 513, "parentSeq": null, "seq": 5, "text": "戱讀與麾同.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0490_0010", "id": null, "offset": 566, "parentSeq": null, "seq": 6, "text": "列口, 縣名也. 度海先得之.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0530_0010", "id": null, "offset": 78, "parentSeq": null, "seq": 1, "text": "高麗所都.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0550_0010", "id": null, "offset": 59, "parentSeq": null, "seq": 1, "text": "譙, 責讓也. 音才笑反.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0550_0010", "id": null, "offset": 82, "parentSeq": null, "seq": 2, "text": "長者, 俾王名也. 送何至沮水, 何因刺殺之.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0020", "id": null, "offset": 58, "parentSeq": null, "seq": 1, "text": "番音普寒切. 一作莫. 遼東有番汗. 燕戰國時, 畧得比也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0020", "id": null, "offset": 88, "parentSeq": null, "seq": 2, "text": "讀曰槌䯻.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0020", "id": null, "offset": 109, "parentSeq": null, "seq": 3, "text": "浿水在樂浪縣, 音普盖切.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0020", "id": null, "offset": 126, "parentSeq": null, "seq": 4, "text": "燕·齊之人, 亡居此地, 及眞番·朝鮮·蠻夷, 皆屬滿也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0020", "id": null, "offset": 131, "parentSeq": null, "seq": 5, "text": "地名. 臣欽若等按後漢書, 濊及沃玘·句驪本皆朝鮮之地, 以渠師爲侯王, 元無族.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0030", "id": null, "offset": 36, "parentSeq": null, "seq": 1, "text": "索或作槖, 音度雒切.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0030", "id": null, "offset": 44, "parentSeq": null, "seq": 2, "text": "姙, 人鳴切.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0030", "id": null, "offset": 102, "parentSeq": null, "seq": 3, "text": "牢圈.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0030", "id": null, "offset": 121, "parentSeq": null, "seq": 4, "text": "蘭卽攔也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0030", "id": null, "offset": 177, "parentSeq": null, "seq": 5, "text": "今高麗中有善斯水, 疑此水是.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0040", "id": null, "offset": 26, "parentSeq": null, "seq": 1, "text": "亦作麗, 音離.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0040", "id": null, "offset": 51, "parentSeq": null, "seq": 2, "text": "一作涓奴.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0040", "id": null, "offset": 68, "parentSeq": null, "seq": 3, "text": "高驪五部. 一曰內部, 一名黃部, 卽桂婁部也. 二曰北部, 一名後部, 卽絶奴部也. 三曰東部, 一名左部, 卽順奴部也. 四曰南部, 一名前部, 卽灌奴部也. 五曰西部, 一名右部, 卽消奴部也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0570_0070", "id": null, "offset": 79, "parentSeq": null, "seq": 1, "text": "一說, 本弁韓之苗裔也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0580_0010", "id": null, "offset": 101, "parentSeq": null, "seq": 1, "text": "一作莫. 遼東有番汗縣, 番音普寒切.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0580_0010", "id": null, "offset": 226, "parentSeq": null, "seq": 2, "text": "昌鋫有險濱縣.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0580_0010", "id": null, "offset": 361, "parentSeq": null, "seq": 3, "text": "眞番·臨屯·樂浪·玄菟.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0580_0020", "id": null, "offset": 70, "parentSeq": null, "seq": 1, "text": "獩一作濊.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0580_0120", "id": null, "offset": 33, "parentSeq": null, "seq": 1, "text": "案今名邪摩堆音之訛也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0010", "id": null, "offset": 463, "parentSeq": null, "seq": 1, "text": "加官號也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0010", "id": null, "offset": 679, "parentSeq": null, "seq": 2, "text": "今魏時也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0020", "id": null, "offset": 36, "parentSeq": null, "seq": 1, "text": "漢 玄菟郡也. 在遼東之東.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0030", "id": null, "offset": 32, "parentSeq": null, "seq": 1, "text": "一名絔耳, 一名小水貊, 在遼東郡 西安平縣北.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0050", "id": null, "offset": 38, "parentSeq": null, "seq": 1, "text": "北沃沮, 一名置溝婁.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0060", "id": null, "offset": 325, "parentSeq": null, "seq": 1, "text": "高三尺, 乘之, 可於果樹下行.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0070", "id": null, "offset": 205, "parentSeq": null, "seq": 1, "text": "魁頭, 猶科頭也. 謂以髮索繞, 成科結也. 紒音計.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0070", "id": null, "offset": 334, "parentSeq": null, "seq": 2, "text": "諸國各有別以爲蘇塗. 諸亡逃至其中, 皆不還之. 蘇塗之義, 有似浮屠.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0110", "id": null, "offset": 32, "parentSeq": null, "seq": 1, "text": "在帶方故地, 南與倭接.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0110", "id": null, "offset": 353, "parentSeq": null, "seq": 2, "text": "仇台爲遼東太守公孫度之婿.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0120", "id": null, "offset": 41, "parentSeq": null, "seq": 1, "text": "在高麗東南, 漢 樂浪居之地.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0590_0130", "id": null, "offset": 37, "parentSeq": null, "seq": 1, "text": "在高麗之北.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0600_0020", "id": null, "offset": 51, "parentSeq": null, "seq": 1, "text": "古鄒大加, 高驪掌賓客之官. 如大鴻臚也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0600_0020", "id": null, "offset": 126, "parentSeq": null, "seq": 2, "text": "復有內評·外評.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0600_0030", "id": null, "offset": 35, "parentSeq": null, "seq": 1, "text": "夏言妃也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0600_0030", "id": null, "offset": 70, "parentSeq": null, "seq": 2, "text": "一作達率.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0600_0030", "id": null, "offset": 225, "parentSeq": null, "seq": 3, "text": "一作喪虞.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0600_0040", "id": null, "offset": 133, "parentSeq": null, "seq": 1, "text": "後唐 同光初, 其王金朴英, 遣倉部侍郞金樂·錄事參軍金幼卿來朝. 二年, 又遣朝散大夫·倉部侍郞金岳來朝. 天成二年, 遣吏中散大夫兵部侍郞張芬·副使兵部郞中朴術法·判官倉部員外郞李忠武來朝. 長興三年, 遣使執事侍郞金咄·副使司賓大卿李儒來朝.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0630_0070", "id": null, "offset": 27, "parentSeq": null, "seq": 1, "text": "一作高連.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0630_0240", "id": null, "offset": 53, "parentSeq": null, "seq": 1, "text": "是時, 使貟外㪚騎侍郞李敎拜 高麗王高連爲都督遼海諸軍事·征東將軍·領東人中郡將·遼束碑公. 高句麗正史闕年月.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0630_0350", "id": null, "offset": 33, "parentSeq": null, "seq": 1, "text": "一作高陽.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0640_0020", "id": null, "offset": 33, "parentSeq": null, "seq": 1, "text": "臣欽若等曰: 「善德, 金眞平之女也. 眞平卒, 無子, 乃立善德爲王, 以宗室大臣乙祭, 總知政國.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0640_0040", "id": null, "offset": 61, "parentSeq": null, "seq": 1, "text": "姓高, 名藏.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0640_0120", "id": null, "offset": 55, "parentSeq": null, "seq": 1, "text": "大祚榮, 聖曆千自立, 爲振國王. 在營州東二千里, 兵數萬人. 至是, 遣郞將崔訢, 往冊命祚榮左驍衛員外大將軍 · 渤海郡王, 仍以其所統爲汗州都督. 自是每歲, 遣使朝貢.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0740_0020", "id": null, "offset": 39, "parentSeq": null, "seq": 1, "text": "東夷有辰韓·馬韓, 謂之三韓國也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0770_0010", "id": null, "offset": 73, "parentSeq": null, "seq": 1, "text": "不朝見天子也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0770_0010", "id": null, "offset": 92, "parentSeq": null, "seq": 2, "text": "譙, 責讓也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0770_0010", "id": null, "offset": 117, "parentSeq": null, "seq": 3, "text": "長者, 裨王名也. 送何至沮水上, 何因刺殺之.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0770_0020", "id": null, "offset": 131, "parentSeq": null, "seq": 1, "text": "音頰.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0770_0020", "id": null, "offset": 169, "parentSeq": null, "seq": 2, "text": "不能與, 猶言不如也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0770_0020", "id": null, "offset": 252, "parentSeq": null, "seq": 3, "text": "右渠之子名長", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0770_0020", "id": null, "offset": 263, "parentSeq": null, "seq": 4, "text": "相路人前已降漢, 而死于道, 故謂之降相. 最者, 其子名.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0790_0020", "id": null, "offset": 45, "parentSeq": null, "seq": 1, "text": "事具帝王親征.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0800_0030", "id": null, "offset": 38, "parentSeq": null, "seq": 1, "text": "時帝親征. 此已後, 至班師事, 具帝王親征門.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0800_0070", "id": null, "offset": 87, "parentSeq": null, "seq": 1, "text": "萬徹入鴨綠水, 俘獲甚衆.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0810_0080", "id": null, "offset": 63, "parentSeq": null, "seq": 1, "text": "明年三月, 勒兵而還.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0870_0040", "id": null, "offset": 31, "parentSeq": null, "seq": 1, "text": "一作眞幹.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0910_0010", "id": null, "offset": 29, "parentSeq": null, "seq": 1, "text": "滿死傳子, 子傳孫, 右渠者其孫名也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0910_0010", "id": null, "offset": 67, "parentSeq": null, "seq": 2, "text": "辰謂辰韓之國也. 雍讀曰壅.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_044_ko_044_0980_0020", "id": null, "offset": 215, "parentSeq": null, "seq": 1, "text": "又云:「高藏加授遼東州都督, 封朝鮮郡王, 遣歸遼東, 以輯高麗餘衆, 先有編附諸軍, 高麗悉放還本蕃. 司農卿扶餘隆爲光祿大夫 · 太嘗員外郞, 加授熊津州都督, 封帶萬郡王, 亦令安輯百濟餘衆, 仍移安東都護府於新城, 以統之. 時百濟本地荒毁, 特令寄於高麗之境, 高藏旣至遼東羅城, 謀叛靺鞨, 召還流邛州, 徙其人於河南 · 隴右. 其舊地沒於新羅, 城傍餘衆後漸寡弱, 散投突厥及靺鞨, 扶餘隆竟亦不敢還舊國, 土地盡沒於靺鞨, 高氏 · 扶餘氏君長遂絶.」.", "type": "원주"}
