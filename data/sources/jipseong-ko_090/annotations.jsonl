{"chunkId": "chunk_jipseong-ko_090_ko_090_0790_0010", "id": null, "offset": 98, "parentSeq": null, "seq": 1, "text": "申王有高麗赤鷹, 岐王有北山黃鶻, 逸翮奇姿特異他等, 上愛之, 每弋獵必置於駕前, 目爲決勝兒.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0800_0010", "id": null, "offset": 9, "parentSeq": null, "seq": 1, "text": "一作東", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0800_0010", "id": null, "offset": 15, "parentSeq": null, "seq": 2, "text": "一作色,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0830_0010", "id": null, "offset": 134, "parentSeq": null, "seq": 1, "text": "方言云小舸謂之艖", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0830_0020", "id": null, "offset": 91, "parentSeq": null, "seq": 1, "text": "一作深.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0830_0030", "id": null, "offset": 73, "parentSeq": null, "seq": 1, "text": "一作日,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0840_0010", "id": null, "offset": 128, "parentSeq": null, "seq": 1, "text": "一作僅", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0840_0030", "id": null, "offset": 108, "parentSeq": null, "seq": 1, "text": "江文通有丹砂可學賦.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0840_0030", "id": null, "offset": 197, "parentSeq": null, "seq": 2, "text": "襲美嘗作弔江都賦, 又新羅僧請爲大師碑文.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0850_0010", "id": null, "offset": 42, "parentSeq": null, "seq": 1, "text": "師云舟人遇鯨則鳴鼓以恐之.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0850_0010", "id": null, "offset": 50, "parentSeq": null, "seq": 2, "text": "日本金桃一實重一斤,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0850_0010", "id": null, "offset": 58, "parentSeq": null, "seq": 3, "text": "以鐵爲瓦輕于陶者.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0860_0020", "id": null, "offset": 9, "parentSeq": null, "seq": 1, "text": "一作海東", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0860_0020", "id": null, "offset": 32, "parentSeq": null, "seq": 2, "text": "一作秋", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0860_0030", "id": null, "offset": 36, "parentSeq": null, "seq": 1, "text": "一作捲", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0870_0010", "id": null, "offset": 5, "parentSeq": null, "seq": 1, "text": "一作之", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0870_0010", "id": null, "offset": 19, "parentSeq": null, "seq": 2, "text": "一作勢", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0870_0010", "id": null, "offset": 41, "parentSeq": null, "seq": 3, "text": "一作呑", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0870_0010", "id": null, "offset": 50, "parentSeq": null, "seq": 4, "text": "一作證東夷.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0880_0010", "id": null, "offset": 34, "parentSeq": null, "seq": 1, "text": "一作直", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0880_0010", "id": null, "offset": 58, "parentSeq": null, "seq": 2, "text": "一作載", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0880_0010", "id": null, "offset": 79, "parentSeq": null, "seq": 3, "text": "一作早晩", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0900_0010", "id": null, "offset": 8, "parentSeq": null, "seq": 1, "text": "丁卯已後", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0900_0010", "id": null, "offset": 151, "parentSeq": null, "seq": 2, "text": "宮司, 書省, 皆宮人職名.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0900_0010", "id": null, "offset": 193, "parentSeq": null, "seq": 3, "text": "上自出東內幽辱, 勵心庶政, 延接丞相之暇日在直學士, 詢以理道, 將致升平.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0920_0010", "id": null, "offset": 18, "parentSeq": null, "seq": 1, "text": "一作地,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0920_0020", "id": null, "offset": 16, "parentSeq": null, "seq": 1, "text": "朱名襄", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0930_0010", "id": null, "offset": 21, "parentSeq": null, "seq": 1, "text": "以下並見海錄碎事.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0930_0010", "id": null, "offset": 56, "parentSeq": null, "seq": 2, "text": "月詩.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0930_0010", "id": null, "offset": 73, "parentSeq": null, "seq": 3, "text": "送道士.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0930_0010", "id": null, "offset": 162, "parentSeq": null, "seq": 4, "text": "少年行.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0960_0010", "id": null, "offset": 8, "parentSeq": null, "seq": 1, "text": "一本題下有 新羅二字", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0970_0010", "id": null, "offset": 36, "parentSeq": null, "seq": 1, "text": "一本無家字,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_0980_0010", "id": null, "offset": 56, "parentSeq": null, "seq": 1, "text": "一作夢,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1000_0020", "id": null, "offset": 6, "parentSeq": null, "seq": 1, "text": "朝鮮史略云, 新羅女主曼, 與魏弘通, 弘死復引年少美丈夫, 私之, 授以要職. 由是佞倖肆志, 紀綱壞弛. 時有人譏謫時政, 榜於路. 主疑隱者王巨仁所爲, 命下獄, 將誅之. 巨仁憤怨作詩, 書獄壁. 是夕忽震雷雨雹, 主懼, 釋之. 唐僖宗 文德初年事也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1010_0010", "id": null, "offset": 354, "parentSeq": null, "seq": 1, "text": "一作原", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1030_0020", "id": null, "offset": 170, "parentSeq": null, "seq": 1, "text": "一作共", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1040_0010", "id": null, "offset": 8, "parentSeq": null, "seq": 1, "text": "時閩嶺用師契丹陷梁 宋", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1060_0010", "id": null, "offset": 6, "parentSeq": null, "seq": 1, "text": "盧氏雜記曰, 江陵寓居士子忘其姓名, 有美姬甚貧, 去遊交廣問戒其姬曰, 我若五年不歸, 任爾改適, 去後五年未歸, 姬遂爲前刺史所納, 在高麗坡底, 及明年歸, 已失姬所在, 尋訪知處, 遂爲詩寄之·刺史見詩, 給一百千及資裝, 遣還士子.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1070_0010", "id": null, "offset": 21, "parentSeq": null, "seq": 1, "text": "高麗使,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1080_0020", "id": null, "offset": 5, "parentSeq": null, "seq": 1, "text": "永徽元年, 眞德大破百濟之衆, 織錦作五言太平詩遣其弟之子法敏以獻.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1080_0020", "id": null, "offset": 24, "parentSeq": null, "seq": 2, "text": "一作成大", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1080_0020", "id": null, "offset": 28, "parentSeq": null, "seq": 3, "text": "一作興", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1080_0020", "id": null, "offset": 91, "parentSeq": null, "seq": 4, "text": "一作淳", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1080_0020", "id": null, "offset": 95, "parentSeq": null, "seq": 5, "text": "一作幽顯,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1080_0020", "id": null, "offset": 127, "parentSeq": null, "seq": 6, "text": "一作任", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1080_0020", "id": null, "offset": 145, "parentSeq": null, "seq": 7, "text": "一作唐家光.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1090_0010", "id": null, "offset": 46, "parentSeq": null, "seq": 1, "text": "一作有", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1100_0010", "id": null, "offset": 19, "parentSeq": null, "seq": 1, "text": "一作京", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1100_0010", "id": null, "offset": 46, "parentSeq": null, "seq": 2, "text": "一作枕", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1100_0010", "id": null, "offset": 55, "parentSeq": null, "seq": 3, "text": "一作朱紱,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1120_0010", "id": null, "offset": 12, "parentSeq": null, "seq": 1, "text": "一作祭", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1120_0010", "id": null, "offset": 57, "parentSeq": null, "seq": 2, "text": "一作下夢,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1130_0010", "id": null, "offset": 8, "parentSeq": null, "seq": 1, "text": "一本無古字, 亦無四首二字, 第三首另一題.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1130_0010", "id": null, "offset": 66, "parentSeq": null, "seq": 2, "text": "一作白", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1130_0010", "id": null, "offset": 69, "parentSeq": null, "seq": 3, "text": "一作化黃", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1130_0010", "id": null, "offset": 81, "parentSeq": null, "seq": 4, "text": "一作塵", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1130_0010", "id": null, "offset": 90, "parentSeq": null, "seq": 5, "text": "一作夜", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1130_0010", "id": null, "offset": 139, "parentSeq": null, "seq": 6, "text": "一作陣", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1130_0030", "id": null, "offset": 63, "parentSeq": null, "seq": 1, "text": "有僧遊日本云, 彼祇有三寺, 上寺名兜率國王供養, 中寺名浮上, 極品官人供養, 下寺名祇上寺, 風俗供養. 有德行卽漸還上也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1130_0040", "id": null, "offset": 7, "parentSeq": null, "seq": 1, "text": "註內缺五字", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1130_0040", "id": null, "offset": 49, "parentSeq": null, "seq": 2, "text": "牛頭大師云, 猶妄心起, 業業如雲. 俱合論云, 入地獄人, 頭向下也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1130_0040", "id": null, "offset": 245, "parentSeq": null, "seq": 3, "text": "鳥窠和尙云, 無事無事爲法道云, 學向上事不入卽須如枯好也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1130_0080", "id": null, "offset": 61, "parentSeq": null, "seq": 1, "text": "南岳石頭大師 劉珂郎中作碑文也", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1150_0010", "id": null, "offset": 32, "parentSeq": null, "seq": 1, "text": "一作御", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1160_0010", "id": null, "offset": 8, "parentSeq": null, "seq": 1, "text": "一作大", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1160_0010", "id": null, "offset": 12, "parentSeq": null, "seq": 2, "text": "一作大", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1160_0010", "id": null, "offset": 19, "parentSeq": null, "seq": 3, "text": "一作在", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1160_0010", "id": null, "offset": 31, "parentSeq": null, "seq": 4, "text": "一作世間多少閑蟲豸,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1160_0010", "id": null, "offset": 33, "parentSeq": null, "seq": 5, "text": "一作盡", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1170_0010", "id": null, "offset": 7, "parentSeq": null, "seq": 1, "text": "貞元十一年春中, 秀才白幽求從新羅王子, 過海失風, 至一高山半復一城臺閣壯麗, 有大樹枝爲風, 相應如人. 誦詩詳詩意殆示之進, 幽求疑未敢前, 俄有朱衣人自城中出傳勅, 諸眞君來殿廊下, 玉女數百奏樂, 白鶴孔雀盤舞應之, 日晩出讜迎月, 殿有四眞君各爲迎月詩, 後一詩忘其下句. 又有童女唱步虛歌, 幽求問從者是何處, 曰諸眞君遊春臺也. 主人是東岳眞君, 四時各隨地分爲遊, 幽求向諸眞君, 乞歸許之, 得隨西岳眞君後操舟, 歸自明州返舊土.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1170_0010", "id": null, "offset": 33, "parentSeq": null, "seq": 2, "text": "大樹枝誦詩.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1170_0010", "id": null, "offset": 60, "parentSeq": null, "seq": 3, "text": "四眞君迎月詩.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1170_0010", "id": null, "offset": 162, "parentSeq": null, "seq": 4, "text": "童女步虛歌.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1180_0010", "id": null, "offset": 11, "parentSeq": null, "seq": 1, "text": "契丹寇幽州, 武懿宗統兵禦之, 至邠畏懦而遁, 毅宗短陋, 元一嘲云云, 則天未曉曰, 懿宗無馬耶, 元一曰, 騎猪夾豸也. 則天大笑, 懿宗曰, 此元一宿搆, 不是卒辭, 則天曰, 以韻與之, 懿宗曰, 請以菶韻, 元一應聲云云, 則天大悅, 懿宗極有慙色.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1180_0020", "id": null, "offset": 8, "parentSeq": null, "seq": 1, "text": "一作雲", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1180_0020", "id": null, "offset": 13, "parentSeq": null, "seq": 2, "text": "上元間旣平, 劉展租庸使元載, 以吳·越雖兵荒後, 民産猶給, 乃召豪吏, 分宰列邑, 重斂之時, 人謂之白著, 言其役斂無名, 所著者皆公然明白, 無所嫌避, 一云世人謂酒酣爲白著, 旣爲刻薄之役, 不堪其弊, 則必顚沛酩酊如醉者之著也. 渤海 高亭有詩云云.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1180_0030", "id": null, "offset": 11, "parentSeq": null, "seq": 1, "text": "薛仁貴擊九姓突厥於天山, 賊遣驍健逆戰, 仁貴發三矢射殺三人, 自餘一時下馬請降, 大捷而還, 軍中歌云云. 於是九姓衰弱, 不復爲患.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1180_0040", "id": null, "offset": 10, "parentSeq": null, "seq": 1, "text": "如意年已來, 始唱黃麞歌, 俄而契丹反判, 總管曹仁師·張玄遇·麻仁節·王孝傑前後百萬衆, 敗於峽石 黃麞谷, 罔有孑遺.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1190_0010", "id": null, "offset": 7, "parentSeq": null, "seq": 1, "text": "梁末帝 貞明三年, 王建立爲王. 市有異人賣古鏡, 有文云云, 文人宋含弘解之曰, 三水中, 四維下, 上帝降子于辰·馬者, 辰韓·馬韓也. 已年中, 二龍見, 一則藏身靑木中, 一則見形黑金東. 靑木松也, 謂松岳郡人以龍爲名者之子孫, 可爲君王也. 黑金, 鐵也, 指鐵圓. 謂今王初盛於此, 殆終滅於此乎. 先操鷄, 後搏鴨者, 王侍中得國後, 先得雞林, 後收鴨綠之意也. 弓裔令物色求異人, 東州 勃颯寺, 有鎭星塑像, 如其狀.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1200_0010", "id": null, "offset": 6, "parentSeq": null, "seq": 1, "text": "武懿宗封河內郡王, 安撫河北民陷, 契丹來歸者, 懿宗總殺之, 流血盈前不顧 初契丹別師何阿小, 陷冀州, 多屠害士女, 至是人以懿宗暴忍似之, 爲之語曰,", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1210_0010", "id": null, "offset": 8, "parentSeq": null, "seq": 1, "text": "高宗遣李勣伐高麗, 侍御史賈言忠計事還, 帝問軍中云何, 言忠以爲男生兄弟䦧牆, 爲我鄕導, 師必克, 引此.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1210_0010", "id": null, "offset": 17, "parentSeq": null, "seq": 2, "text": "一作賊無歷底中道回.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1220_0010", "id": null, "offset": 36, "parentSeq": null, "seq": 1, "text": "靑𤨏高議又戴一謠云, 山上一群鹿, 大鹿來相逐. 啼殺澗下羊, 却被猪兒觸.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1230_0010", "id": null, "offset": 7, "parentSeq": null, "seq": 1, "text": "日本高僧傳云, 天平勝寶四年, 藤原淸河爲遣唐大使, 至長安見元宗. 元宗曰, 聞彼國有賢君, 今觀使者趨揖有異, 乃號日本爲禮儀君子國, 命晁衡導淸河等視府庫及三敎殿, 又圖淸河貌, 納於蕃藏中, 及歸賜詩.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1230_0020", "id": null, "offset": 7, "parentSeq": null, "seq": 1, "text": "東國通鑑 新羅紀, 唐 天寶十五年, 遣使朝帝於蜀, 帝親製十韻詩手札, 賜王曰, 嘉新羅王歲脩朝貢, 克踐禮樂名義, 賜詩一首, 其詩曰.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1240_0010", "id": null, "offset": 12, "parentSeq": null, "seq": 1, "text": "釋空海性靈集序云, 和尙昔在唐, 日作離合詩, 贈土僧惟上泉州別駕馬總, 一時大才也. 覽則驚怪, 因贈詩云.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1250_0010", "id": null, "offset": 7, "parentSeq": null, "seq": 1, "text": "又見性靈集序中", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1260_0010", "id": null, "offset": 23, "parentSeq": null, "seq": 1, "text": "見鑑眞和尙傳, 按鑑眞, 示寂在天平寶字六年, 鶴林奉使, 未詳在何年.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1270", "id": null, "offset": 11, "parentSeq": null, "seq": 1, "text": "延歷中, 空海歸自唐表上所齋書籍中, 有朱千乘詩集一卷.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1270_0010", "id": null, "offset": 3, "parentSeq": null, "seq": 1, "text": "見千載佳句", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1270_0010", "id": null, "offset": 21, "parentSeq": null, "seq": 2, "text": "新移鏡中別業.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1280_0020", "id": null, "offset": 9, "parentSeq": null, "seq": 1, "text": "見千載佳句", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1280_0030", "id": null, "offset": 21, "parentSeq": null, "seq": 1, "text": "登慈和山 東人詩話云崔文昌侯致遠, 入唐登第, 以文章著名. 題潤州 慈和寺有畵角云云之句, 後鷄林價客入唐購詩, 有以此句書示者.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1280_0030", "id": null, "offset": 39, "parentSeq": null, "seq": 2, "text": "長安柳", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1280_0030", "id": null, "offset": 57, "parentSeq": null, "seq": 3, "text": "留贈洛中友人", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1280_0030", "id": null, "offset": 75, "parentSeq": null, "seq": 4, "text": "送舍弟嚴府", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1280_0030", "id": null, "offset": 93, "parentSeq": null, "seq": 5, "text": "春日", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1280_0030", "id": null, "offset": 111, "parentSeq": null, "seq": 6, "text": "成名後酬進士田仁義見贈", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1280_0030", "id": null, "offset": 129, "parentSeq": null, "seq": 7, "text": "江山春懷.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1290_0020", "id": null, "offset": 3, "parentSeq": null, "seq": 1, "text": "見千載佳句", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1290_0020", "id": null, "offset": 21, "parentSeq": null, "seq": 2, "text": "秋夜望月", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1290_0020", "id": null, "offset": 39, "parentSeq": null, "seq": 3, "text": "峽山寺翫月", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1290_0020", "id": null, "offset": 57, "parentSeq": null, "seq": 4, "text": "贈靑龍寺僧", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1290_0020", "id": null, "offset": 75, "parentSeq": null, "seq": 5, "text": "宿豊德寺", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1290_0020", "id": null, "offset": 93, "parentSeq": null, "seq": 6, "text": "贈僧", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1290_0020", "id": null, "offset": 111, "parentSeq": null, "seq": 7, "text": "秋夕", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1290_0020", "id": null, "offset": 129, "parentSeq": null, "seq": 8, "text": "早春", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1300_0010", "id": null, "offset": 3, "parentSeq": null, "seq": 1, "text": "見千載佳句", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1300_0010", "id": null, "offset": 21, "parentSeq": null, "seq": 2, "text": "題遊仙寺.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1310_0010", "id": null, "offset": 21, "parentSeq": null, "seq": 1, "text": "幽居", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1310_0010", "id": null, "offset": 39, "parentSeq": null, "seq": 2, "text": "題潘岳六城南店, 店是源贊善處", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_090_ko_090_1310_0010", "id": null, "offset": 57, "parentSeq": null, "seq": 3, "text": "山中.", "type": "원주"}
