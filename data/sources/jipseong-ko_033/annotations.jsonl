{"chunkId": "chunk_jipseong-ko_033_ko_033_0020_0040", "id": null, "offset": 20, "parentSeq": null, "seq": 1, "text": "五月甲子 此月壬午朔, 無甲子. 日干有誤.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0030_0020", "id": null, "offset": 47, "parentSeq": null, "seq": 1, "text": "一旬而罷 北史 隋本紀下作「二旬而罷.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0030_0100", "id": null, "offset": 38, "parentSeq": null, "seq": 1, "text": "張鎭州 本書陳稜傳作 「張鎭周.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0040_0010", "id": null, "offset": 322, "parentSeq": null, "seq": 1, "text": "種落還集 「還」, 朝鮮 金富軾 三國史記二○作", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0040_0010", "id": null, "offset": 899, "parentSeq": null, "seq": 2, "text": "三令五申 「三」 原作 「先」, 據三國史記二○及北史 隋本紀下改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0040_0010", "id": null, "offset": 934, "parentSeq": null, "seq": 3, "text": "海冥道　三國史記二○作 「冥海道」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0040_0010", "id": null, "offset": 1296, "parentSeq": null, "seq": 4, "text": "浿江 「浿」 原作 「沮」 , 據三國史記二○改. 本書高麗傳: 「都於平壤, 南臨浿水.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0040_0030", "id": null, "offset": 114, "parentSeq": null, "seq": 1, "text": "甲午　通鑑考異: 長曆是月庚辰朔, 戊戌之下, 不容有甲午·乙未. 此必誤也. 按: 此處 「甲午」 疑應作 「甲子」 , 屬四月.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0040_0060", "id": null, "offset": 60, "parentSeq": null, "seq": 1, "text": "將帥奔還亡者二千餘騎　按: 本書宇文述傳作 「及還至遼東城, 唯二千七百人.」 「亡」, 通志一八作 「至」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0040_0120", "id": null, "offset": 19, "parentSeq": null, "seq": 1, "text": "壬午　此月乙巳朔, 無壬午. 日干有誤.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0040_0160", "id": null, "offset": 54, "parentSeq": null, "seq": 1, "text": "贊務　應作 「贊治」 , 唐人諱改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0050_0010", "id": null, "offset": 39, "parentSeq": null, "seq": 1, "text": "大業三年　據本書煬帝紀上·通鑑 隋紀四, 大業二年, 侑封爲代王.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0060_0010", "id": null, "offset": 402, "parentSeq": null, "seq": 1, "text": "建纓拂　對照其他各團所用器物的顔色, 第四團用烏絲連玄犀甲, 疑此處 「建纓拂」 當作 「緇纓拂」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0090_0020", "id": null, "offset": 90, "parentSeq": null, "seq": 1, "text": "倭國 「倭」 原作 「俀」 , 今改正. 參看本書東夷傳校勘記〔六〕.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0090_0040", "id": null, "offset": 20, "parentSeq": null, "seq": 1, "text": "歌曲有芝栖舞曲有歌芝栖　册府五七○, 「芝栖」 作 「歌芝栖」 , 「歌芝栖」 作 「舞枝棲」, 御覽五六七, 「芝栖」 作 「歌芝栖」 , 「歌芝栖」 作 「舞芝栖」 . 但都載於 「安國」 條下.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0190_0030", "id": null, "offset": 25, "parentSeq": null, "seq": 1, "text": "河南 扶風三郡 「三」 疑應作 「二」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0200_0010", "id": null, "offset": 390, "parentSeq": null, "seq": 1, "text": "慕容佛允　本書吐谷渾傳, 「佛」 作 「伏」 , 音譯異字.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0220_0020", "id": null, "offset": 233, "parentSeq": null, "seq": 1, "text": "置五郡十一縣龍城 廣興 定荒屬昌黎郡 石城 廣都屬建德郡 原脫 「十」 下十五字, 據魏書 地形志上補. 參看卄二史考異.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0220_0020", "id": null, "offset": 276, "parentSeq": null, "seq": 2, "text": "後齊唯留昌黎一郡　原脫 「昌」 字, 據卄二史考異補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0220_0030", "id": null, "offset": 97, "parentSeq": null, "seq": 1, "text": "泃河 「泃」 原作 「洵」 , 據水經一四鮑邱水注改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0220_0040", "id": null, "offset": 141, "parentSeq": null, "seq": 1, "text": "溫水 「溫」 原作 「涅」 , 據水經一四濡水注改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0220_0040", "id": null, "offset": 153, "parentSeq": null, "seq": 2, "text": "巨梁水 「巨」 原作 「臣」 , 據水經一四鮑邱水注改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0220_0060", "id": null, "offset": 107, "parentSeq": null, "seq": 1, "text": "新昌 「新」 原作 「親」 , 據魏書 地形志上改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0220_0070", "id": null, "offset": 320, "parentSeq": null, "seq": 1, "text": "仕官不偶遇冀部 「官」 當作 「宦」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0230_0010", "id": null, "offset": 224, "parentSeq": null, "seq": 1, "text": "阿勿俟斤 本書突厥傳作 「阿勿思力俟斤」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0260_0020", "id": null, "offset": 1101, "parentSeq": null, "seq": 1, "text": "白衣 北史 蘇威傳作 「御使」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0430_0030", "id": null, "offset": 807, "parentSeq": null, "seq": 1, "text": "西突厥傳 原脫 「西」 字, 今補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0460_0020", "id": null, "offset": 7, "parentSeq": null, "seq": 1, "text": "李子雄　北史本傳作 「李雄」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0460_0020", "id": null, "offset": 90, "parentSeq": null, "seq": 2, "text": "廉州　原作 「廣州」 , 據北史 李雄傳改. 按: 本書地理志中趙郡 稿城縣條: 「〔開皇〕十年置廉州, 十八年改爲稿城縣, 大業初州廢.」 廉州距幽州較近, 而廣州則距幽州甚遠. 作廉州, 是.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0460_0020", "id": null, "offset": 476, "parentSeq": null, "seq": 3, "text": "東平　本書來護兒傳作 「東萊」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0460_0070", "id": null, "offset": 59, "parentSeq": null, "seq": 1, "text": "隋", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0470_0010", "id": null, "offset": 20, "parentSeq": null, "seq": 1, "text": "廣平 任人 「任」 下原衍 「城」 字. 按: 漢書地理志下, 廣平國有任縣. 至北魏, 仍設此縣. 魏書 游明根傳（元是明根的玄孫）也作 「廣平任人」 . 今據刪.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0470_0010", "id": null, "offset": 173, "parentSeq": null, "seq": 2, "text": "蓋牟道 「牟」 , 本書煬帝紀下作 「蓋馬道」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0490_0030", "id": null, "offset": 21, "parentSeq": null, "seq": 1, "text": "頻陽　原作 「穎陽」 , 據北史本傳改. 按: 本書地理志上, 華原縣有頻山. 元和志二·寰宇記三一載美原縣南有頻陽故城.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0010", "id": null, "offset": 347, "parentSeq": null, "seq": 1, "text": "璉六世孫湯 「湯」, 本書高祖紀上作 「陽」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0010", "id": null, "offset": 531, "parentSeq": null, "seq": 2, "text": "意侯奢 「侯」 , 周書 異域傳作 「俟」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0020", "id": null, "offset": 306, "parentSeq": null, "seq": 1, "text": "左平　通典一八五作 「左率」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0020", "id": null, "offset": 364, "parentSeq": null, "seq": 2, "text": "李德　北史 百濟傳作 「季德」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0020", "id": null, "offset": 385, "parentSeq": null, "seq": 3, "text": "次對德以下皆黃帶次文督　北史 百濟傳, 「皆黃帶」 在 「次文督」 下.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0020", "id": null, "offset": 498, "parentSeq": null, "seq": 4, "text": "其人雜有新羅高麗倭等 「倭」 原作 「俀」. 按: 古從 「委」 和從 「妥」 的字, 有時可以通用. 如 「桵」 或作 「㮃」, 「緌」 或作 「綏」. 「俀」 應是 「倭」 字的別體. 本書煬帝紀上作 「倭」. 本卷和他處作 「俀」 者, 今一律改爲 「倭」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0020", "id": null, "offset": 682, "parentSeq": null, "seq": 5, "text": "苩氏 「苩」 原作 「苗」, 據通典一八五改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0030", "id": null, "offset": 211, "parentSeq": null, "seq": 1, "text": "因襲百濟附庸於迦羅國　通典一八五作 「因襲加羅·任那諸國滅之.」 據三國史記, 有金官·古寧諸加邪國, 均爲新羅所倂, 疑 「於」 字是 「諸」 字之訛.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0030", "id": null, "offset": 308, "parentSeq": null, "seq": 2, "text": "吉土　三國史記三八作 「吉士」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0030", "id": null, "offset": 364, "parentSeq": null, "seq": 3, "text": "烽戍邏俱有屯管部伍　通典一八五, 「管」 作 「營」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0040", "id": null, "offset": 40, "parentSeq": null, "seq": 1, "text": "粟末　原作 「栗未」 , 據册府九五六·新唐書 黑水渤海靺鞨傳·通鑑 武德四年胡注改. 下同.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0060", "id": null, "offset": 353, "parentSeq": null, "seq": 1, "text": "多利思比孤 「比」 原作 「北」 , 據北史 倭國傳·通典一八五·通鑑 大業四年改. 下同.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0060", "id": null, "offset": 1168, "parentSeq": null, "seq": 2, "text": "必先跨犬　北史 倭國傳, 「犬」 作 「火」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0550_0060", "id": null, "offset": 1470, "parentSeq": null, "seq": 3, "text": "裴淸　應作 「裴世淸」 , 唐人避諱, 省 「世」 字.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0570_0010", "id": null, "offset": 471, "parentSeq": null, "seq": 1, "text": "呂夸　周書及北史 吐谷渾傳·通典一九○作 「夸呂」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0570_0010", "id": null, "offset": 612, "parentSeq": null, "seq": 2, "text": "其名王十三人　本書元諧傳作 「名王十七人·公侯十三人」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0570_0010", "id": null, "offset": 1619, "parentSeq": null, "seq": 3, "text": "伏允　北史 吐谷渾傳或作 「允伏」 , 或作 「伏允」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0570_0020", "id": null, "offset": 108, "parentSeq": null, "seq": 1, "text": "蠕蠕　下文作 「茹茹」 , 同音異譯.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0570_0020", "id": null, "offset": 605, "parentSeq": null, "seq": 2, "text": "貪汗山 「汗」 原作 「汚」 , 據本書突厥傳·北史 高昌傳·通典一九一改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0570_0030", "id": null, "offset": 344, "parentSeq": null, "seq": 1, "text": "靑海 「靑」 原作 「淸」 , 據北史 西域傳論·通典一九三·御覽七九二改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0010", "id": null, "offset": 428, "parentSeq": null, "seq": 1, "text": "弟逸可汗立　周書 突厥傳作 「子科羅立, 科羅號乙息記可汗」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0010", "id": null, "offset": 453, "parentSeq": null, "seq": 2, "text": "俟斗　周書 突厥傳作 「俟斤」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0010", "id": null, "offset": 2284, "parentSeq": null, "seq": 3, "text": "契丹　北史 突厥傳作 「契骨」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0010", "id": null, "offset": 4272, "parentSeq": null, "seq": 4, "text": "當令侍子入朝 「令」 原作 「今」 , 據北史 突厥傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0010", "id": null, "offset": 4354, "parentSeq": null, "seq": 5, "text": "窟含眞　本書高祖紀作 「庫合眞」.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0010", "id": null, "offset": 5593, "parentSeq": null, "seq": 6, "text": "時沙鉢略子曰染干　本書長孫晟傳作 「處羅侯之子曰染干」 . 岑仲勉 突厥集史卷二: 「通典一九七作『沙鉢略之弟處羅侯之子染干』, 隋傳殆有脫文.」", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0010", "id": null, "offset": 5642, "parentSeq": null, "seq": 7, "text": "突利 「利」 原作 「厥」 , 據北史 突厥傳·册府九七八改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0010", "id": null, "offset": 6826, "parentSeq": null, "seq": 8, "text": "奚 霫五部內徙 「徙」 原作 「從」, 據北史 突厥傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0010", "id": null, "offset": 7531, "parentSeq": null, "seq": 9, "text": "意利珍豆啓民可汗 「豆」 原作 「寶」 , 據上文及文館詞林六六四改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0020", "id": null, "offset": 1086, "parentSeq": null, "seq": 1, "text": "大斗拔谷 「斗」 原作 「升」 , 據北史 突厥傳及本書煬帝紀上·又楊玄感傳改.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0020", "id": null, "offset": 1825, "parentSeq": null, "seq": 2, "text": "達度闕 「闕」 原作 「關」 , 據北史 突厥傳改. 本書裴矩傳作 「闕達度設」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0020", "id": null, "offset": 1843, "parentSeq": null, "seq": 3, "text": "曷薩那可汗　通鑑 煬帝 大業八年作 「曷婆那可汗」 . 通鑑 考異: 「唐 李軌傳作『曷娑那可汗』. 今從隋書.」 是司馬光所見隋書與今本不同.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0030", "id": null, "offset": 131, "parentSeq": null, "seq": 1, "text": "烏讙　北史 鐵勒傳作 「烏護」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0030", "id": null, "offset": 143, "parentSeq": null, "seq": 2, "text": "於尼讙　北史 鐵勒傳作 「於尼護」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0030", "id": null, "offset": 197, "parentSeq": null, "seq": 3, "text": "曷𡽱　北史 鐵勒傳作 「曷截」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0030", "id": null, "offset": 204, "parentSeq": null, "seq": 4, "text": "比干　或作 「比千」 . 北史 鐵勒傳作 「比干」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0030", "id": null, "offset": 223, "parentSeq": null, "seq": 5, "text": "拔也未渴達　北史 鐵勒傳作 「拔也末謁達」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0030", "id": null, "offset": 248, "parentSeq": null, "seq": 6, "text": "蔑促　北史 鐵勒傳作 「篾促」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0030", "id": null, "offset": 255, "parentSeq": null, "seq": 7, "text": "隆忽 北史 鐵勒傳作 「薩忽」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0030", "id": null, "offset": 427, "parentSeq": null, "seq": 8, "text": "晉王廣北征納啓民　原脫 「啓」 字, 據北史 鐵勒傳補.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0040", "id": null, "offset": 83, "parentSeq": null, "seq": 1, "text": "辱紇王 「王」 , 周書 庫莫奚傳·北史 奚傳·通典二○○作 「主」 .", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_033_ko_033_0580_0060", "id": null, "offset": 12, "parentSeq": null, "seq": 1, "text": "室韋 契丹之類也 「室韋」 原缺, 據北史 室韋傳補.", "type": "원주"}
