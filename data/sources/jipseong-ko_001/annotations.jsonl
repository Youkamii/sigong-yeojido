{"chunkId": "chunk_jipseong-ko_001_ko_001_0010_0010", "id": null, "offset": 13, "parentSeq": null, "seq": 1, "text": "謂入伐齊.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0010_0010", "id": null, "offset": 80, "parentSeq": null, "seq": 2, "text": "先者使卒戍緣陵, 今有狄難, 故致之.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0010_0010", "id": null, "offset": 90, "parentSeq": null, "seq": 3, "text": "後故, 地名.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0010_0010", "id": null, "offset": 103, "parentSeq": null, "seq": 4, "text": "謂敗狄所得車甲及貨盡與小侯.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0010_0010", "id": null, "offset": 122, "parentSeq": null, "seq": 5, "text": "近齊之大侯, 則以齊縣分之. 終不踐其國以侵之.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0010_0010", "id": null, "offset": 129, "parentSeq": null, "seq": 6, "text": "謂不來救齊. 北州謂北之州, 卽幽州·營州等.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0010_0010", "id": null, "offset": 140, "parentSeq": null, "seq": 7, "text": "謂伐楚盟於召陵也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0010_0010", "id": null, "offset": 159, "parentSeq": null, "seq": 8, "text": "小國齊自謂.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0010_0010", "id": null, "offset": 178, "parentSeq": null, "seq": 9, "text": "言諸侯以敬順天命, 救齊伐狄.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0010_0010", "id": null, "offset": 228, "parentSeq": null, "seq": 10, "text": "令支, 國名.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0010_0010", "id": null, "offset": 239, "parentSeq": null, "seq": 11, "text": "孤竹, 國名. 斬其君.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 41, "parentSeq": null, "seq": 1, "text": "亦地名也", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 92, "parentSeq": null, "seq": 2, "text": "謂岱山之北", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 112, "parentSeq": null, "seq": 3, "text": "紀隨, 地名.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 184, "parentSeq": null, "seq": 4, "text": "分吳地之半.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 191, "parentSeq": null, "seq": 5, "text": "蔡陵地名.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 203, "parentSeq": null, "seq": 6, "text": "旣割越地. 又據宋·鄭之國, 以爲親援也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 213, "parentSeq": null, "seq": 7, "text": "伐楚時渡汝水.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 218, "parentSeq": null, "seq": 8, "text": "謂方城之地.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 223, "parentSeq": null, "seq": 9, "text": "楚山也", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 232, "parentSeq": null, "seq": 10, "text": "使貢楚絲, 卽所謂檿絲者也. 堪爲琴瑟絃.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 241, "parentSeq": null, "seq": 11, "text": "周室有事, 歸胙于齊, 齊太嶽之後, 故言隆嶽.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 273, "parentSeq": null, "seq": 12, "text": "屠何, 東胡之先也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 280, "parentSeq": null, "seq": 13, "text": "北狄以騎爲寇.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 329, "parentSeq": null, "seq": 14, "text": "謂龍門之西河.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 347, "parentSeq": null, "seq": 15, "text": "石沈, 地名.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 370, "parentSeq": null, "seq": 16, "text": "與卑耳之貉, 共拘秦夏之不服者.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 379, "parentSeq": null, "seq": 17, "text": "西虞, 國名.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 397, "parentSeq": null, "seq": 18, "text": "自救徐州已下有十二也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 433, "parentSeq": null, "seq": 19, "text": "書謂要盟之辭載之於策.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 443, "parentSeq": null, "seq": 20, "text": "謂以上下之神祇爲盟誓, 又以其牲薦之於神.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 503, "parentSeq": null, "seq": 21, "text": "翳所以蔽兵, 謂脅盾之屬. 不解甲於壘, 不解兵於翳, 言不用也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0010", "id": null, "offset": 513, "parentSeq": null, "seq": 22, "text": "弢, 弓衣也. 無弓無矢, 亦言不用也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0020", "id": null, "offset": 84, "parentSeq": null, "seq": 1, "text": "皆南夷之國號也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0020_0020", "id": null, "offset": 105, "parentSeq": null, "seq": 2, "text": "中國之人, 不尊崇樂推, 使居臣位, 是卑我也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0030_0010", "id": null, "offset": 1, "parentSeq": null, "seq": 1, "text": "(桓公)", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0030_0010", "id": null, "offset": 77, "parentSeq": null, "seq": 2, "text": "汶, 音岷. 岷山, 江水所從出.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0030_0010", "id": null, "offset": 105, "parentSeq": null, "seq": 3, "text": "自伐秦而遂存晉於晉之南, 故曰東存.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 29, "parentSeq": null, "seq": 1, "text": "逆, 迎也, 謂用此恭遜等以相迎接也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 37, "parentSeq": null, "seq": 2, "text": "遜以接人, 有何失乎！", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 58, "parentSeq": null, "seq": 3, "text": "苟爲不遜, 身尙不得, 況於人乎!", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 101, "parentSeq": null, "seq": 4, "text": "直用恭遜·敬愛, 足以理天下, 更不須益.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 112, "parentSeq": null, "seq": 5, "text": "雖復一身用恭遜·敬愛, 理之纔可足耳. 亦不須損也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 145, "parentSeq": null, "seq": 6, "text": "有恭遜·敬愛則理, 無之則亂也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 159, "parentSeq": null, "seq": 7, "text": "恭遜·敬愛, 身之粉澤也. 故在身則榮, 去身則辱也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 182, "parentSeq": null, "seq": 8, "text": "夷貉之人 殘戾凶暴, 苟以恭遜·敬愛化之. 可使生愛.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 203, "parentSeq": null, "seq": 9, "text": "父母兄弟, 恩情結固, 苟無恭遜·敬愛化之. 可令生惡.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 213, "parentSeq": null, "seq": 10, "text": "之, 是也. 同是此身. 有恭遜·敬愛則愛, 無之則惡.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 221, "parentSeq": null, "seq": 11, "text": "同是此身之名. 有恭遜·敬愛則榮, 無之則辱也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 235, "parentSeq": null, "seq": 12, "text": "言恭遜·敬愛, 可以變化愛惡榮辱名物之善惡, 如天地之生殺也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0040_0010", "id": null, "offset": 242, "parentSeq": null, "seq": 13, "text": "道者, 貴作變化也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0050_0010", "id": null, "offset": 43, "parentSeq": null, "seq": 1, "text": "將上山, 纒束其馬, 懸鉤其車也. 卑耳, 即齊語所謂辟耳.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0060_0010", "id": null, "offset": 29, "parentSeq": null, "seq": 1, "text": "闟, 住立貌. 瞠, 驚視貎.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0060_0010", "id": null, "offset": 232, "parentSeq": null, "seq": 2, "text": "謂贊引渡水者.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0070_0010", "id": null, "offset": 11, "parentSeq": null, "seq": 1, "text": "還四年, 後四年.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0070_0010", "id": null, "offset": 18, "parentSeq": null, "seq": 2, "text": "丁氏, 齊之富人. 所謂丁惠也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0070_0010", "id": null, "offset": 31, "parentSeq": null, "seq": 3, "text": "食, 音嗣. 下以意取, 行五月, 經五月.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0070_0010", "id": null, "offset": 67, "parentSeq": null, "seq": 4, "text": "音致, 下皆同.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0070_0010", "id": null, "offset": 77, "parentSeq": null, "seq": 5, "text": "即家粟也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0070_0010", "id": null, "offset": 141, "parentSeq": null, "seq": 6, "text": "革, 更也. 賦, 敷也. 籍, 席也, 才夜反.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0100_0020", "id": null, "offset": 155, "parentSeq": null, "seq": 1, "text": "渠展, 齊地. 泲水所流入海之處. 可煑鹽之所也. 故曰渠展之鹽", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0100_0020", "id": null, "offset": 163, "parentSeq": null, "seq": 2, "text": "草枯曰菹, 采居反.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0100_0020", "id": null, "offset": 172, "parentSeq": null, "seq": 3, "text": "音征.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0100_0020", "id": null, "offset": 282, "parentSeq": null, "seq": 4, "text": "庸, 功也.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0100_0020", "id": null, "offset": 287, "parentSeq": null, "seq": 5, "text": "北海之衆, 謂北海煑鹽之人. 本意禁人煑鹽, 託以農事慮有妨奪, 先自大夫起, 欲人不知其機, 斯為權術.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0100_0020", "id": null, "offset": 363, "parentSeq": null, "seq": 6, "text": "本國自無鹽, 遠饋而食. 圉, 與禦同.", "type": "원주"}
{"chunkId": "chunk_jipseong-ko_001_ko_001_0100_0030", "id": null, "offset": 80, "parentSeq": null, "seq": 1, "text": "他臥切, 落毛也.", "type": "원주"}
