      "excerpts": [
        {
          "id": "ex-anchangho-vital",
          "text": "출생 연도 1878년(고종 15) 사망 연도 1938년",
          "locator": "기본정보표"
        },
        {
          "id": "ex-anchangho-1919",
          "text": "1919년 3 · 1운동 직후 상해로 건너가 상해임시정부 의 내무총장 겸 국무총리 대리직을 맡아",
          "locator": "생애 및 활동사항"
        }
      ]
    },
    {
      "id": "src-encykorea-han-yongun",
      "title": "한용운 · 한국민족문화대백과사전",
      "publisher": "한국학중앙연구원",
      "url": "https://encykorea.aks.ac.kr/Article/E0061853",
      "rawFile": "raw/E0061853-han-yongun.html",
      "sha256": "458fa45c179d7f4847c8ea1ee661b107851c197cdbc9e31f779dbfacad2050ce",
      "license": "unverified — 항목 페이지 푸터 표기 'Copyright the Academy of Korean Studies. All Rights Reserved.' 외 본문 재사용 조건 미확인",
      "excerpts": [
        {
          "id": "ex-hanyongun-vital",
          "text": "출생 연도 1879년(고종 16) 8월 29일 사망 연도 1944년 6월 29일",
          "locator": "기본정보표"
        },
        {
          "id": "ex-hanyongun-33",
          "text": "독립선언서에 서명한 민족대표 33인",
          "locator": "정의"
        },
        {
          "id": "ex-hanyongun-1919",
          "text": "1919년 3·1독립운동 때 백용성(白龍城) 등과 함께 불교계를 대표하여 참여하였다.",
          "locator": "활동사항"
        }
      ]
    },
    {
      "id": "src-encykorea-son-byeonghui",
      "title": "손병희 · 한국민족문화대백과사전",
      "publisher": "한국학중앙연구원",
      "url": "https://encykorea.aks.ac.kr/Article/E0030507",
      "rawFile": "raw/E0030507-son-byeonghui.html",
      "sha256": "4da774d5313e3417563430f520665d9394f42da0113ec719a0450c56ea754749",
      "license": "unverified — 항목 페이지 푸터 표기 'Copyright the Academy of Korean Studies. All Rights Reserved.' 외 본문 재사용 조건 미확인",
      "excerpts": [
        {
          "id": "ex-sonbyeonghui-vital",
          "text": "출생 연도 1861년(철종 12) 사망 연도 1922년",
          "locator": "기본정보표"
        },
        {
          "id": "ex-sonbyeonghui-role",
          "text": "손병희는 천도교측의 대표로 3·1운동의 주동체로 참가,",
          "locator": "생애 및 활동사항"
        },
        {
          "id": "ex-sonbyeonghui-print",
          "text": "1919년 2월 27일 밤 천도교 직영의 보성사에서 독립선언문 2만 1000매를 인쇄,",
          "locator": "생애 및 활동사항"
        }
      ]
    },
    {
      "id": "src-encykorea-yi-seungman",
      "title": "이승만 · 한국민족문화대백과사전",
      "publisher": "한국학중앙연구원",
      "url": "https://encykorea.aks.ac.kr/Article/E0044938",
      "rawFile": "raw/E0044938-yi-seungman.html",
      "sha256": "bdd82d7ab87a71ac4c88c99c32eadaa21722fa646af5e0217be5ef1d7f8d3129",
      "license": "unverified — 항목 페이지 푸터 표기 'Copyright the Academy of Korean Studies. All Rights Reserved.' 외 본문 재사용 조건 미확인",
      "excerpts": [
        {
          "id": "ex-yiseungman-vital",
          "text": "출생 연도 1875년(고종 12) 사망 연도 1965년",
          "locator": "기본정보표"
        },
        {
          "id": "ex-yiseungman-def",
          "text": "대한민국 제1·2·3대 대통령을 역임한 정치인.",
          "locator": "정의"
        },
        {
          "id": "ex-yiseungman-1919",
          "text": "상해 임시정부 의정원은 1919년 9월 6일 이승만을 임시 대통령으로 추대하여",
          "locator": "생애 및 활동사항"
        }
      ]
    },
    {
      "id": "src-encykorea-samil-movement",
      "title": "3·1운동 · 한국민족문화대백과사전",
      "publisher": "한국학중앙연구원",
      "url": "https://encykorea.aks.ac.kr/Article/E0026772",
      "rawFile": "raw/E0026772-samil-movement.html",
      "sha256": "810c1be3df941871d7a7577a990432be5f3e195ae52703ae34cbdc012c30f34b",
      "license": "unverified — 항목 페이지 푸터 표기 'Copyright the Academy of Korean Studies. All Rights Reserved.' 외 본문 재사용 조건 미확인",
      "excerpts": [
        {
          "id": "ex-samil-def",
          "text": "1919년 3월 1일을 기해 일어난 거족적인 독립만세운동.",
          "locator": "정의"
        },
        {
          "id": "ex-samil-kpg",
          "text": "중국 상하이에서의 대한민국임시정부 수립으로 이어졌다.",
          "locator": "내용 요약"
        },
        {
          "id": "ex-samil-taehwagwan",
          "text": "서울 인사동 태화관(泰華館) 에 모여",
          "locator": "경과"
        },
        {
          "id": "ex-samil-hanyongun",
          "text": "독립을 선언하는 한용운의 간단한 식사를 들은 후,",
          "locator": "경과"
        }
      ]
    }
  ],
