   "excerpts": [
    {
     "id": "ex-busanjin-def",
     "locator": "정의",
     "text": "1592년(선조 25) 4월 14일 정발(鄭撥) 등이 부산진에서 일본군과 싸운 전투."
    },
    {
     "id": "ex-busanjin-fleet",
     "locator": "내용 (4월 14일 부산포 침입)",
     "text": "400여척의 병선으로"
    },
    {
     "id": "ex-busanjin-landing",
     "locator": "내용 (다음날 이른 아침)",
     "text": "적군은 우암(牛巖)쪽에서 상륙하여"
    },
    {
     "id": "ex-busanjin-attack",
     "locator": "내용 (다음날 이른 아침)",
     "text": "세 방면에서 성을 공격하였다."
    },
    {
     "id": "ex-busanjin-civilians",
     "locator": "내용 (성안 상황)",
     "text": "성안의 남녀노소가 모두 분전하였으나"
    },
    {
     "id": "ex-busanjin-fall",
     "locator": "내용 (성안 상황)",
     "text": "성은 함락되었다."
    }
   ],
   "sha256": "bf0b32d2d87c961b911bc870271b20f67d0d84637c2557b943dffd1e6dae3b0a"
  },
  {
   "id": "src-encykorea-dongnae",
   "title": "동래전투(東萊戰鬪) - 한국민족문화대백과사전",
   "publisher": "한국학중앙연구원 한국민족문화대백과사전",
   "url": "https://encykorea.aks.ac.kr/Article/E0016386",
   "rawFile": "raw/encykorea-dongnae-E0016386.html",
   "license": "공공누리 (페이지 표기: '한국민족문화대백과사전은 공공저작물로서 공공누리 제도에 따라 이용 가능합니다.')",
   "excerpts": [
    {
     "id": "ex-dongnae-outline",
     "locator": "개설",
     "text": "1592년(선조 25) 4월 15일 동래성을 지키던 조선군이 일본군과 맞서 싸우다 함락당한 전투이다."
    },
    {
     "id": "ex-dongnae-song",
     "locator": "개설",
     "text": "당시 동래부사 송상현"
    },
    {
     "id": "ex-dongnae-siege",
     "locator": "경과",
     "text": "일본군이 3중으로 성을 포위한 뒤"
    },
    {
     "id": "ex-dongnae-civilians",
     "locator": "경과",
     "text": "동래성의 백성들까지도 모두 싸움에 참가하였다."
    }
   ],
   "sha256": "eda44d7384c3701bfd68bb24df2bc6b668e4f7695030f591d920bfd20b8d83ae"
  },
