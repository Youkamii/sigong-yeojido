  "missing": [
    {
      "topic": "우금치 싸움의 진압 측 부대 표기",
      "detail": "전봉준 항목의 인용 절은 공주 공격과 우금치 대패만 적고 맞선 부대 이름(일본군·정부군)은 뒤 문장에 있어 페이지당 25단어 인용 한도 안에서 넣지 못했다. 그래서 이 장면에는 진압 측 참가자를 세우지 않았다.",
      "affectedScenes": [
        "scene-ugeumchi-1894"
      ]
    },
    {
      "topic": "구 러시아공사관 실측 좌표",
      "detail": "위키백과 「구 러시아 공사관」 문서와 위키데이터 Q12585324 모두 좌표(P625)가 없고, 국가유산청 계열 사이트는 이번 지침상 요청하지 않았다. 그래서 서울 도시 표시점으로만 배치했다.",
      "affectedScenes": [
        "scene-agwan-pacheon-1896"
      ]
    },
    {
      "topic": "을사늑약 체결 장소의 문헌 확정",
      "detail": "인용한 한국민족문화대백과사전 본문은 “궁중”·“궁궐”로만 적고 경운궁 중명전을 명시하지 않는다. 중명전 좌표는 표시용으로만 썼고, 체결 장소를 확정하는 별도 근거는 이번에 내려받지 못했다.",
      "affectedScenes": [
        "scene-eulsa-1905"
      ]
    },
    {
      "topic": "하얼빈 의거 날짜 표기 차이",
      "detail": "안중근 항목 요약문은 “9월 하얼빈역에서 이토를 사살”로 적고, 같은 사전의 다른 서술과 기존 카탈로그 인용은 1909년 10월 26일로 적는다. 두 표기를 합치지 않고 연도(1909)만 확정했다.",
      "affectedScenes": [
        "scene-harbin-1909"
      ]
    },
    {
      "topic": "한일병합조약 조인 자체의 시각·장소",
      "detail": "인용한 문장은 8월 22일 어전회의 절차까지만 적는다. 조인 시각·장소(통감관저 등)를 확정하는 인용은 페이지당 25단어 한도 안에서 넣지 못했다.",
      "affectedScenes": [
        "scene-annexation-1910"
      ]
    },
    {
      "topic": "청산리 일대 좌표",
      "detail": "위키데이터 청산리 전투(Q490156)와 위키백과 문서 모두 좌표가 없어 간도 청산리의 지리좌표를 얻지 못했다. 한반도 밖 사건이라 임의 배치를 하지 않고 lon/lat 을 비워 두었다.",
      "affectedScenes": [
        "scene-cheongsanri-1920"
      ]
    },
    {
      "topic": "1945년 광복 당일의 장소 있는 장면",
      "detail": "8·15광복 항목과 여운형 항목의 인용문 모두 장소를 적지 않아 좌표를 비웠다. 장소가 붙은 광복 episode(서대문형무소 출옥, 총독부와의 행정권 이양 교섭, 서울역·거리 환영 등)는 별도 출처 확보가 필요하다.",
      "affectedScenes": [
        "scene-gwangbok-geonjun-1945"
      ]
    },
    {
      "topic": "1926년 6·10만세운동과 1932년 훙커우공원 의거 장면",
      "detail": "두 사건의 한국민족문화대백과사전 항목 ID를 이번 실행에서 확인하지 못했고(사전 검색 경로는 robots 로 차단), 김구 항목 인용만으로는 훙커우공원이라는 장소가 확인되지 않아 장면을 만들지 않았다.",
      "affectedScenes": []
    },
    {
      "topic": "1930~40년대 국내 장면 밀도",
      "detail": "1929년 광주학생운동 다음으로 1945년까지의 국내 장면은 이번 배치에 없다. 조선어학회사건·원산총파업 등은 항목 ID 확인과 추가 내려받기가 필요하다.",
      "affectedScenes": []
    },
    {
      "topic": "1896년 『독립신문』 창간 장면",
      "detail": "서재필 항목은 1896년 4월 7일 창간 사실과 순 한글 민간 신문이라는 성격까지 적지만 발행 장소를 적지 않는다. 『독립신문』 항목의 사전 ID 를 이번 실행에서 확인하지 못해, 장소 근거 없이 장면을 만들지 않았다.",
      "affectedScenes": []
