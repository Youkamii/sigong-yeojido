  "missing": [
    {
      "id": "miss-hs4-1",
      "itemId": "hs-samguk-gangseo-daemyo",
      "topic": "강서대묘 축조·벽화 연대",
      "reason": "조성 연도를 담은 근거 없음 — 표시용 기준 연도(610)",
      "detail": "민족문화대백과는 6세기 후반~7세기 초, 위키백과는 7세기 초로만 적어 연도 숫자 주장을 만들지 못했다. 이번에 국가유산포털(heritage.go.kr)은 이 환경에서 접속 자체가 되지 않았고, 영어 위키백과 'Kangso Three Tombs'·'Complex of Koguryo Tombs', 한국어 위키백과 '강서대묘'·'강서고분', 민족문화대백과 '강서대묘', 로컬 원문 chunk(삼국사기·금석문)를 다시 뒤졌으나 축조 연도를 적은 대목은 없었다. 대신 위키백과의 7세기 초 서술을 두 번째 근거로 달고(claim-gap-gangseo-1), 좌표를 강서삼묘 자리로 고쳤다(claim-gap-gangseo-2). 장면의 610년은 여전히 표시용 기준점이다.",
      "neededSource": "국가유산포털 또는 북한 고고 보고의 축조 연대 서술"
    },
    {
      "id": "miss-hs4-4",
      "itemId": "hs-samguk-bangasayusang",
      "topic": "금동미륵보살반가사유상(국보 83호) 제작국·제작 연도",
      "reason": "제작국과 연도가 갈려 확정 근거 없음 — 표시용 기준 연도(602)",
      "detail": "민족문화대백과는 백제설과 신라설이 있고 제작 연대는 '대체로 7세기 전반'으로만 적는다. 이번에 민족문화대백과 '금동미륵보살반가사유상'(E0007681) 전문과 한국어 위키백과 해당 문서를 다시 읽고 로컬 금석문·집성 chunk 에서 반가사유상 명문을 찾아봤으나, 제작국이나 제작 연도를 못 박은 명문·발굴 자료는 없었다. 출토지 자체가 알려지지 않아 발굴 근거가 나올 자리도 없다. 장면의 602년은 백제 무왕대(602~641)설을 기준점으로 삼은 표시값이다.",
      "neededSource": "제작 연도를 못 박은 명문 또는 발굴 자료"
    }
  ],
